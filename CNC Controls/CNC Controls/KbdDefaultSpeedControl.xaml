<UserControl x:Class="CNC.Controls.KbdDefaultSpeedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CNC.Controls"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="20" d:DesignWidth="180">
    <!-- Run-bar readout of the keyboard jog panel's default continuous-jog speed - the speed used when
         jogging by keyboard with no modifier held (Shift/Ctrl+Shift still reach the other one either way -
         see KeypressHandler.DefaultSpeedFast). Backed by the SAME KeyboardJogViewModel the real Keyboard
         Jogging panel (KbdJogGridControl) uses - not a fresh read of Config.Jog - so toggling here also
         pushes straight into the live KeypressHandler.DefaultSpeedFast (see SpeedIndex's setter) instead of
         only updating the persisted config until next restart. Selected chip highlighted the same light
         green (#9FE09F) KbdJogGridControl uses for its own Slow/Fast cells, for visual consistency. -->
    <UserControl.Resources>
        <Style x:Key="SlowChip" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="3,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=SpeedIndex}" Value="0">
                    <Setter Property="Background" Value="#FF9FE09F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FastChip" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="3,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=SpeedIndex}" Value="1">
                    <Setter Property="Background" Value="#FF9FE09F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel x:Name="pnlRoot" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand"
                MouseLeftButtonUp="pnlRoot_MouseLeftButtonUp"
                ToolTip="Default keyboard jog speed (no modifier held) - click to toggle Slow/Fast.">
        <Label x:Uid="lbl_kbdDefSpeed" Content="Kbd Def Speed:" Padding="0" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <Border Style="{StaticResource SlowChip}">
            <TextBlock Text="{Binding Path=SlowText}" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text=" " VerticalAlignment="Center"/>
        <Border Style="{StaticResource FastChip}">
            <TextBlock Text="{Binding Path=FastText}" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text=" mm/min" VerticalAlignment="Center" Margin="2,0,0,0"/>
    </StackPanel>
</UserControl>
