<UserControl x:Class="CNC.Controls.UiRemoteConfigControl"
             x:Uid="ctl_uiRemoteConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CNC.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <!-- Settings > User Interface > Remote. The enable lived only on the Height map tab, which is where it
         was first needed (place the plate, press Continue, sixteen times, laptop across the shop) - but a
         press now means something during any prompt, any running job and any hold, so the setting belongs
         with the other input settings rather than inside one feature. The Height map checkbox binds the
         same property and stays in step. -->
    <GroupBox x:Uid="grp_uiRemote" Header="Remote" Margin="5">
        <StackPanel Margin="5">
            <CheckBox x:Uid="lbl_shutterRemoteEnabled" Content="A shutter remote drives the machine (volume keys)"
                      Margin="5,0,0,0" IsChecked="{Binding Path=ShutterRemoteEnabled, Mode=TwoWay}"
                      ToolTip="Lets a cheap Bluetooth camera shutter remote act as a one-button pendant, so you can answer a prompt or hold the machine with your hands on the work instead of at the keyboard. Pair the remote to Windows as an ordinary keyboard first - ioSender does not pair to it itself. Off by default: it listens using a system-wide keyboard hook, and nobody who has not asked for that should get it."/>

            <!-- Binding status. Ticking the box arms a one-shot bind; this is what says so, and what
                 reports the result. Without it the whole thing happens silently apart from a chime, and
                 an operator has no way to tell "waiting for your press" from "not working". -->
            <Border x:Uid="bdr_remoteBinding" Margin="5,10,0,0" Padding="8,6" CornerRadius="3"
                    BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Uid="lbl_remoteBindStatus" x:Name="txtBindStatus" VerticalAlignment="Center"
                               TextWrapping="Wrap" Text="Not bound"/>
                    <Button x:Uid="btn_remoteRebind" x:Name="btnRebind" Content="Rebind" Margin="12,0,0,0"
                            Padding="10,2" VerticalAlignment="Center" Click="btnRebind_Click"
                            ToolTip="Forget the bound remote and listen for the next button press. Use this after replacing the remote."/>
                </StackPanel>
            </Border>

            <CheckBox x:Uid="lbl_remoteSwapButtons" Content="Swap the two buttons" Margin="5,8,0,0"
                      IsChecked="{Binding Path=ShutterRemoteSwapButtons, Mode=TwoWay}"
                      ToolTip="Which physical button is the primary one. Set for you when you bind - the button you press becomes the primary - so you only need this if you want the other one to be OK/Start instead."/>

            <TextBlock x:Uid="lbl_remoteWhatKeysDo" Margin="5,10,0,0" TextWrapping="Wrap" Opacity="0.75"
                       Text="The remote's two buttons are not marked, and which one sends which media key is not something anyone should have to know - on the PICO the larger top button is the one that sends volume DOWN. So the button you press when binding becomes the PRIMARY one, and the other is the second. Swap them below if you change your mind."/>

            <Grid Margin="24,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="lbl_remoteHdrWhen" Grid.Row="0" Grid.Column="0" Text="When" FontWeight="Bold" Margin="0,0,18,4"/>
                <TextBlock x:Uid="lbl_remoteHdrUp" Grid.Row="0" Grid.Column="1" Text="Primary button" FontWeight="Bold" Margin="0,0,18,4"/>
                <TextBlock x:Uid="lbl_remoteHdrDown" Grid.Row="0" Grid.Column="2" Text="Second button" FontWeight="Bold" Margin="0,0,0,4"/>

                <TextBlock x:Uid="lbl_remoteRowPrompt" Grid.Row="1" Grid.Column="0" Text="A prompt is on screen" Margin="0,0,18,2"/>
                <TextBlock x:Uid="lbl_remoteRowPromptUp" Grid.Row="1" Grid.Column="1" Text="OK / Yes" Margin="0,0,18,2"/>
                <TextBlock x:Uid="lbl_remoteRowPromptDown" Grid.Row="1" Grid.Column="2" Text="Cancel / No" Margin="0,0,0,2"/>

                <TextBlock x:Uid="lbl_remoteRowMap" Grid.Row="2" Grid.Column="0" Text="Height map is waiting" Margin="0,0,18,2"/>
                <TextBlock x:Uid="lbl_remoteRowMapUp" Grid.Row="2" Grid.Column="1" Text="Continue" Margin="0,0,18,2"/>
                <TextBlock x:Uid="lbl_remoteRowMapDown" Grid.Row="2" Grid.Column="2" Text="Continue" Margin="0,0,0,2"/>

                <TextBlock x:Uid="lbl_remoteRowRun" Grid.Row="3" Grid.Column="0" Text="A job is running" Margin="0,0,18,2"/>
                <TextBlock x:Uid="lbl_remoteRowRunUp" Grid.Row="3" Grid.Column="1" Text="Feed Hold" Margin="0,0,18,2"/>
                <TextBlock x:Uid="lbl_remoteRowRunDown" Grid.Row="3" Grid.Column="2" Text="Feed Hold" Margin="0,0,0,2"/>

                <TextBlock x:Uid="lbl_remoteRowHold" Grid.Row="4" Grid.Column="0" Text="The machine is holding" Margin="0,0,18,2"/>
                <TextBlock x:Uid="lbl_remoteRowHoldUp" Grid.Row="4" Grid.Column="1" Text="Start / resume" Margin="0,0,18,2"/>
                <TextBlock x:Uid="lbl_remoteRowHoldDown" Grid.Row="4" Grid.Column="2" Text="Stop" Margin="0,0,0,2"/>
            </Grid>

            <TextBlock x:Uid="lbl_remoteNoCancel" Margin="24,6,0,0" TextWrapping="Wrap" Opacity="0.75"
                       Text="When a prompt has no Cancel button - as the &quot;move the plate to the next corner&quot; prompt does not - both buttons mean OK. There is nothing else the second button could mean there, and a button that did nothing would just be one you have to remember not to press."/>

            <TextBlock x:Uid="lbl_remoteFallthrough" Margin="5,10,0,0" TextWrapping="Wrap" Opacity="0.75"
                       Text="Once bound, the remote's buttons belong to ioSender: a press that means nothing at that moment beeps and is discarded, never reaching the volume control. Every other device is ignored and behaves exactly as before, so your keyboard's own volume keys are untouched. Both buttons mean Feed Hold while a job runs on purpose - a hand reaching for the remote mid-cut wants the machine to stop, not to pick the right button of two."/>
        </StackPanel>
    </GroupBox>
</UserControl>
