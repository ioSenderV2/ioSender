<UserControl x:Class="CNC.Controls.UiOverlayConfigControl"
             x:Uid="ctl_uiOverlayConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CNC.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <!-- Settings > User Interface > Overlay. A front end for the overlay engine that already existed
         behind Help > Support (CNC Core/ConfigOverlay.cs): an overlay is a trimmed App.config carrying
         just the sections it means to change, layered on this profile at the next load.

         Why a page and not just the menu item: the menu only ever offered a file dialog, so applying an
         overlay a second time meant finding the file again, and there was nowhere to see what you had.
         This lists a library instead - the operator's own folder plus anything shipped with the build.

         APPLY RESTARTS ioSender, which is why selecting in the list does nothing on its own. The merge
         has to happen before ConfigStore reads the document (dozens of call sites write the whole config
         during a session and would clobber a live edit), so Apply stages the fragment and relaunches -
         see AppConfig.StageOverlay. A combo box whose selection restarted the app would be indefensible. -->
    <GroupBox x:Uid="grp_uiOverlay" Header="Overlay" Margin="5">
        <StackPanel Margin="5">
            <TextBlock x:Uid="lbl_overlayIntro" Margin="5,0,0,0" TextWrapping="Wrap" Opacity="0.75"
                       Text="An overlay is a saved arrangement - the tab bar, the panels, the screen layout - that you can apply over your own settings without touching your machine setup, profiles, macros or fixtures. Applying one restarts ioSender and can be undone."/>

            <Grid Margin="24,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="lbl_overlayAvailable" Grid.Row="0" Grid.Column="0" Text="Available overlays" Margin="0,0,18,0" VerticalAlignment="Center"
                           ToolTip="Overlays in your own Overlays folder, plus any that shipped with this build."/>
                <ComboBox x:Uid="cbo_overlay" x:Name="cboOverlay" Grid.Row="0" Grid.Column="1" MinWidth="280" Margin="0,0,10,0"
                          DisplayMemberPath="Label" SelectionChanged="Overlay_SelectionChanged"
                          ToolTip="Pick an overlay to see what it would change. Nothing is applied until you press Apply."/>
                <Button x:Uid="btn_overlayBrowse" x:Name="btnBrowse" Grid.Row="0" Grid.Column="2" Content="Browse PC..." Padding="10,2" MinWidth="110" Click="Browse_Click"
                        ToolTip="Pick an overlay file from anywhere on this PC. A copy is kept in your own Overlays folder so it stays in this list, and nothing is applied until you press Apply."/>

                <!-- What the selected overlay would change. The sections are named outright rather than
                     summarised: this is a config holding the operator's machine, fixtures, probes and
                     macros, and "apply this overlay?" tells them nothing about what is about to move. -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,10,0" Padding="10,8"
                        BorderBrush="#FFCCCCCC" BorderThickness="1" Background="#FFFAFAFA">
                    <StackPanel>
                        <TextBlock x:Name="lblOverlayName" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="lblOverlaySource" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock x:Uid="lbl_overlayChanges" Text="Changes these parts of your configuration:" Margin="0,8,0,2" Opacity="0.75"/>
                        <TextBlock x:Name="lblOverlaySections" TextWrapping="Wrap" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="24,12,0,0">
                <Button x:Uid="btn_overlayApply" x:Name="btnApply" Content="Apply" Padding="14,3" MinWidth="110" Click="Apply_Click"
                        ToolTip="Back up your current configuration, layer the selected overlay onto it, and restart ioSender."/>
                <Button x:Uid="btn_overlayUndo" x:Name="btnUndo" Content="Undo last overlay" Padding="10,3" MinWidth="140" Margin="10,0,0,0" Click="Undo_Click"
                        ToolTip="Put your configuration back as it was immediately before the last overlay was applied. Anything changed since then is lost. ioSender restarts."/>
                <Button x:Uid="btn_overlayFolder" x:Name="btnFolder" Content="Open folder" Padding="10,3" MinWidth="110" Margin="10,0,0,0" Click="Folder_Click"
                        ToolTip="Open your own Overlays folder, to remove one you no longer want or to copy one in by hand."/>
            </StackPanel>

            <TextBlock x:Name="lblLastApplied" Margin="29,10,0,0" TextWrapping="Wrap" Opacity="0.75"/>

            <TextBlock x:Uid="lbl_overlayExportNote" Margin="29,10,0,0" TextWrapping="Wrap" Opacity="0.75"
                       Text="To make one of your own, arrange the screen the way you want it and use Help > Support > Export configuration overlay. The connection port, network host and machine are deliberately never included, so an overlay is safe to hand to someone else."/>
        </StackPanel>
    </GroupBox>
</UserControl>
