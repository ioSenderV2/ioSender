<UserControl x:Class="CNC.Controls.RunStripPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CNC.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="110" d:DesignWidth="620">

    <!--
        The run strip's right half, built to the spec in docs/RunStrip-Layout-Spec.md.

        Three headed columns - Jogging | Signals | Feeds and Speeds - sitting to the right of the jog
        pad. Written rather than assembled from existing controls because the two pieces it would have
        reused do not fit: OverrideControl is slider-based where this wants a compact "- value +"
        stepper, and SignalsControl renders one undifferentiated block with no way to group it.

        This XAML is knowingly throwaway - the desktop client retires at phase H. Its job is to settle
        a layout worth porting to the web client, so it is the design surface, not the deliverable.
    -->

    <UserControl.Resources>
        <!-- One consistent look for every "-" / "+" nudge button in here. Small, square, and flat, so
             three rows of them read as a column of values rather than a wall of buttons. -->
        <Style x:Key="NudgeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- The value between the nudges. Read-only: these are machine truth (an override percentage
             the controller reports), not something typed - the buttons are the only way to change
             them, so an editable box would imply a control path that does not exist. -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <!-- One of two mutually exclusive speeds. Flat and unbordered until it is the active one,
             so the pair reads as a choice rather than as two buttons to press. -->
        <Style x:Key="SpeedChoiceStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- A signal lamp: the letter itself, dim when clear and red when asserted. Colour is set from
             code-behind (see UpdateSignals) rather than a converter - a per-letter converter would need
             a resource entry per instance, and a missing x:Key is a runtime-only crash. -->
        <Style x:Key="SignalLetterStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Foreground" Value="#FFBBBBBB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- ==================== JOGGING ==================== -->
        <StackPanel Orientation="Vertical" Margin="0,0,16,0">
            <TextBlock x:Uid="hdr_jogging" Text="JOGGING" Style="{StaticResource GroupHeaderStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="lbl_jogDistance" Grid.Row="0" Grid.Column="0" Text="Distance:" Style="{StaticResource RowLabelStyle}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Uid="btn_jogDistMinus" Style="{StaticResource NudgeButtonStyle}" Content="&#8722;" Click="JogDistMinus_Click" ToolTip="Smaller jog distance"/>
                    <TextBlock x:Name="lblJogDistance" Style="{StaticResource ValueStyle}"/>
                    <Button x:Uid="btn_jogDistPlus" Style="{StaticResource NudgeButtonStyle}" Content="+" Click="JogDistPlus_Click" ToolTip="Larger jog distance"/>
                </StackPanel>

                <TextBlock x:Uid="lbl_jogSpeed" Grid.Row="1" Grid.Column="0" Text="Speed:" Style="{StaticResource RowLabelStyle}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,0">
                    <Button x:Uid="btn_jogSpeedMinus" Style="{StaticResource NudgeButtonStyle}" Content="&#8722;" Click="JogSpeedMinus_Click" ToolTip="Slower jog"/>
                    <TextBlock x:Name="lblJogSpeed" Style="{StaticResource ValueStyle}"/>
                    <Button x:Uid="btn_jogSpeedPlus" Style="{StaticResource NudgeButtonStyle}" Content="+" Click="JogSpeedPlus_Click" ToolTip="Faster jog"/>
                </StackPanel>

                <TextBlock x:Uid="lbl_kbdDef" Grid.Row="2" Grid.Column="0" Text="Kbd Def:" Style="{StaticResource RowLabelStyle}"/>
                <!-- Just the two speeds, with the active one highlighted. The unit lives in the
                     tooltip: on a strip this dense the digits are worth more than "mm/min", and the
                     operator already knows what their machine measures in. -->
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                    <StackPanel.ToolTip>
                        <TextBlock><Run x:Uid="txt_kbdDefTip" Text="Default keyboard jog speed"/><Run Text=" ("/><Run Text="{Binding Path=FeedrateUnit, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    </StackPanel.ToolTip>
                    <Button x:Name="btnKbdSlow" Style="{StaticResource SpeedChoiceStyle}" Click="KbdSlow_Click"/>
                    <Button x:Name="btnKbdFast" Style="{StaticResource SpeedChoiceStyle}" Click="KbdFast_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ==================== SIGNALS ==================== -->
        <StackPanel Orientation="Vertical" Margin="0,0,16,0">
            <TextBlock x:Uid="hdr_signals" Text="SIGNALS" Style="{StaticResource GroupHeaderStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="lbl_sigLimit" Grid.Row="0" Grid.Column="0" Text="Limit:" Style="{StaticResource RowLabelStyle}"/>
                <StackPanel x:Name="rowLimit" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>

                <TextBlock x:Uid="lbl_sigSteppers" Grid.Row="1" Grid.Column="0" Text="Steppers:" Style="{StaticResource RowLabelStyle}"/>
                <StackPanel x:Name="rowSteppers" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0"/>

                <TextBlock x:Uid="lbl_sigProbes" Grid.Row="2" Grid.Column="0" Text="Probes:" Style="{StaticResource RowLabelStyle}"/>
                <StackPanel x:Name="rowProbes" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0"/>

                <TextBlock x:Uid="lbl_tloRef" Grid.Row="3" Grid.Column="0" Text="TLO ref:" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="lblTloRef" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueStyle}"
                           HorizontalAlignment="Left" Margin="0,2,0,0"
                           ToolTip="Tool length offset reference. Blank until one has been set."/>
            </Grid>
        </StackPanel>

        <!-- ==================== FEEDS AND SPEEDS ==================== -->
        <StackPanel Orientation="Vertical">
            <TextBlock x:Uid="hdr_feedsSpeeds" Text="FEEDS AND SPEEDS" Style="{StaticResource GroupHeaderStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="lbl_ovrFeed" Grid.Row="0" Grid.Column="0" Text="Feed rate:" Style="{StaticResource RowLabelStyle}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Uid="btn_feedOvrMinus" Style="{StaticResource NudgeButtonStyle}" Content="&#8722;" Click="FeedOvrMinus_Click" ToolTip="Feed override down"/>
                    <TextBlock x:Name="lblFeedOvr" Style="{StaticResource ValueStyle}"
                               MouseLeftButtonUp="FeedOvrReset_Click" Cursor="Hand" ToolTip="Click to reset to 100%"/>
                    <Button x:Uid="btn_feedOvrPlus" Style="{StaticResource NudgeButtonStyle}" Content="+" Click="FeedOvrPlus_Click" ToolTip="Feed override up"/>
                </StackPanel>

                <TextBlock x:Uid="lbl_ovrRapids" Grid.Row="1" Grid.Column="0" Text="Rapids:" Style="{StaticResource RowLabelStyle}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,0">
                    <Button x:Uid="btn_rapidOvrMinus" Style="{StaticResource NudgeButtonStyle}" Content="&#8722;" Click="RapidOvrMinus_Click" ToolTip="Rapids override down (100 / 50 / 25 only)"/>
                    <TextBlock x:Name="lblRapidOvr" Style="{StaticResource ValueStyle}"
                               MouseLeftButtonUp="RapidOvrReset_Click" Cursor="Hand" ToolTip="Click to reset to 100%"/>
                    <Button x:Uid="btn_rapidOvrPlus" Style="{StaticResource NudgeButtonStyle}" Content="+" Click="RapidOvrPlus_Click" ToolTip="Rapids override up (100 / 50 / 25 only)"/>
                </StackPanel>

                <TextBlock x:Uid="lbl_ovrSpindle" Grid.Row="2" Grid.Column="0" Text="Spindle:" Style="{StaticResource RowLabelStyle}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,0">
                    <Button x:Uid="btn_spindleOvrMinus" Style="{StaticResource NudgeButtonStyle}" Content="&#8722;" Click="SpindleOvrMinus_Click" ToolTip="Spindle override down"/>
                    <TextBlock x:Name="lblSpindleOvr" Style="{StaticResource ValueStyle}"
                               MouseLeftButtonUp="SpindleOvrReset_Click" Cursor="Hand" ToolTip="Click to reset to 100%"/>
                    <Button x:Uid="btn_spindleOvrPlus" Style="{StaticResource NudgeButtonStyle}" Content="+" Click="SpindleOvrPlus_Click" ToolTip="Spindle override up"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
