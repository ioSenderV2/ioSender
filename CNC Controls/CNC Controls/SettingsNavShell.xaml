<UserControl x:Class="CNC.Controls.SettingsNavShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CNC.Controls"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Registered here in the same edit as its first use: a missing x:Key for a converter is a
             runtime-only XamlParseException, which builds clean and crashes on next launch. -->
        <local:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- A row is a label, optionally preceded by a status dot. Machine Setup grades its steps
             green/orange/red; Settings pages have no status and show no dot. -->
        <HierarchicalDataTemplate DataType="{x:Type local:SettingsNavNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                         Fill="{Binding StatusBrush}"
                         Visibility="{Binding StatusBrush, Converter={StaticResource NullToVis}}"/>
                <TextBlock Text="{Binding Label}" Margin="0,2" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Width/MinWidth are computed from the widest label at runtime - see AutoSizeNav().
                 These are only the starting values before the first measure. -->
            <ColumnDefinition x:Name="navColumn" Width="250" MinWidth="150"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Left: search + navigation tree -->
        <DockPanel Grid.Column="0" Margin="6,6,0,6">
            <Border DockPanel.Dock="Top" BorderBrush="#FFABADB3" BorderThickness="1" Background="White" Margin="0,0,0,6">
                <Grid>
                    <TextBox x:Uid="fld_settingsSearch" x:Name="searchBox" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" Padding="4,3" UndoLimit="0"
                             TextChanged="searchBox_TextChanged" KeyDown="searchBox_KeyDown"
                             ToolTip="Filter the list below. Esc clears."/>
                    <!-- Placeholder text, shown only while the box is empty and unfocused. -->
                    <TextBlock x:Uid="lbl_settingsSearchHint" x:Name="searchHint" Text="Search"
                               Foreground="#FF9AA0A6" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <TreeView x:Uid="tree_settingsNav" x:Name="navTree" BorderThickness="1"
                      SelectedItemChanged="navTree_SelectedItemChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Visibility" Value="{Binding IsShown, Converter={StaticResource BoolToVis}}"/>
                        <Setter Property="Padding" Value="2,1"/>
                        <Style.Triggers>
                            <!-- A category is a heading, not a destination: clicking it expands rather than
                                 selecting an empty right-hand pane. -->
                            <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Focusable" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" Background="#FFBCBCBC"/>

        <!-- Right: the selected page -->
        <Grid Grid.Column="2" Margin="6">
            <ScrollViewer x:Name="pageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ContentPresenter x:Name="pageHost" Content="{Binding SelectedNode.Content, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </ScrollViewer>
            <TextBlock x:Uid="lbl_settingsNoSelection" x:Name="emptyHint" Text="Select a page on the left."
                       Foreground="#FF9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
