<Window x:Class="CNC.Controls.RestorePointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CNC.Controls"
        mc:Ignorable="d"
        d:DesignHeight="580" d:DesignWidth="620"
        x:Uid="wnd_restorePoint" Title="Restore" Height="580" Width="820" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="App.ico">
    <!-- Height is 580, not the original 460: rows 0, 2 and 3 are all Auto and only the snapshot list is
         starred, so every line the intro or the Restore group gains comes straight out of the list. At 460
         the list had already shrunk to a sliver and the buttons were clipped off the bottom edge - found in
         tools/render-harness, which renders this window at its declared size. -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Uid="txt_restoreIntro" Grid.Row="0" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Pick the moment you want to go back to. A restore point can hold the machine's settings, its work offsets, ioSender's own configuration, or any combination - what it holds is shown beside it."/>

        <DataGrid x:Uid="dgrSnapshots" x:Name="dgrSnapshots" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  CanUserReorderColumns="False" CanUserResizeRows="False" CanUserAddRows="False"
                  CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  SelectionChanged="dgrSnapshots_SelectionChanged"
                  MouseDoubleClick="dgrSnapshots_MouseDoubleClick">
            <DataGrid.Columns>
                <!-- Auto, not a fixed width. At 150 the stamp clipped to "2026-09-20 05:1" - losing exactly
                     the digits that tell two restore points from the same session apart - and widening it to
                     175 still cut the seconds. A number tuned against one font at one DPI is a guess that
                     breaks on the next machine; Auto sizes to the content and cannot clip. -->
                <DataGridTextColumn x:Uid="col_rpSaved" Header="Saved" Binding="{Binding SavedText}" Width="Auto"/>
                <DataGridTextColumn x:Uid="col_rpAge" Header="When" Binding="{Binding AgeText}" Width="Auto"/>
                <DataGridTextColumn x:Uid="col_rpContains" Header="Contains" Binding="{Binding ContainsText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- What to put back. Shown for every restore point rather than only the both-kinds ones, so the
             choice is always in the same place and a point holding one kind visibly says so (the other
             option disables) instead of the dialog silently changing shape. -->
        <GroupBox x:Uid="grp_rpWhat" Grid.Row="2" Header="Restore" Margin="0,8,0,0">
            <StackPanel Margin="6,4">
                <RadioButton x:Uid="rb_rpBoth" x:Name="rbBoth" GroupName="rpwhat" Content="Both" IsChecked="True"
                             ToolTip="Put back the machine's settings and ioSender's configuration as they were at this moment."/>
                <RadioButton x:Uid="rb_rpGrbl" x:Name="rbGrbl" GroupName="rpwhat" Content="Machine settings only (the controller's $ values)" Margin="0,4,0,0"
                             ToolTip="Homing, limits, travel, feeds - everything stored in the controller itself."/>
                <RadioButton x:Uid="rb_rpConfig" x:Name="rbConfig" GroupName="rpwhat" Content="App configuration only (profiles, probes, fixtures, layout)" Margin="0,4,0,0"
                             ToolTip="ioSender's own settings. Restoring these restarts ioSender, because the configuration is read once at startup."/>
                <!-- Work offsets are a CHECKBOX, not a fourth radio: they are a different kind of action.
                     The radios above choose between two whole-machine restores that replace each other;
                     writing G54-G59.3 back is an independent thing you may want alongside either, or on
                     its own. Both boxes start UNCHECKED even when the point has offsets - ticking one
                     overwrites the work zero currently on the machine, and someone who came here for the
                     app configuration must not lose a freshly probed G54 to a box they did not read. -->
                <Separator Margin="0,8,0,6"/>
                <CheckBox x:Uid="chk_rpOffsets" x:Name="chkOffsets" Content="Work offsets and tool table (G54-G59.3)"
                          ToolTip="Writes the stored work coordinate systems and tool table back to the controller. No motion - these are G10 writes, the same kind of thing as restoring a $ setting. This overwrites the work zero currently set on the machine."/>
                <!-- Content is a wrapping TextBlock, not a plain string: as a string the label is measured on
                     one line and simply runs off the edge of the dialog, which is how it shipped - the half
                     that says it MOVES the machine was the half that disappeared. A CheckBox does not wrap a
                     string Content at any width, and this one is long on purpose. -->
                <CheckBox x:Uid="chk_rpOffsetPositions" x:Name="chkOffsetPositions" Margin="18,4,0,0"
                          ToolTip="G28 and G30 can only be restored by driving to each position and teaching it, so this opens the snapshot as a program in the Job tab for you to run. It begins with a warning and an M0 pause. Nothing moves until you press Start.">
                    <TextBlock x:Uid="txt_rpOffsetPositions" TextWrapping="Wrap"
                               Text="Also the G28 / G30 positions - this MOVES the machine"/>
                </CheckBox>
                <TextBlock x:Name="txtWhatNote" Foreground="#586069" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnBrowse" x:Uid="btn_rpBrowse" Content="Browse..." MinWidth="90" Margin="0,0,8,0" Click="btnBrowse_Click"
                    ToolTip="Choose a controller settings file directly, if what you want is not listed above."/>
            <Button x:Name="btnRestore" x:Uid="btn_rpRestore" Content="Restore" MinWidth="90" Margin="0,0,8,0" IsDefault="True" Click="btnRestore_Click"/>
            <Button x:Name="btnCancel" x:Uid="btn_rpCancel" Content="Cancel" MinWidth="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
