<Window x:Class="CNC.Controls.SecretPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DesignHeight="160" d:DesignWidth="420"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" MinWidth="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="ioSender" Icon="App.ico">
    <StackPanel Margin="16">
        <TextBlock x:Name="txtPrompt" TextWrapping="Wrap" MaxWidth="420" FontSize="15" Margin="0,0,0,10"/>
        <PasswordBox x:Name="pwdValue" MinWidth="340" Padding="4" KeyDown="pwdValue_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnOk" Content="OK" Click="btnOk_Click" IsDefault="True" MinWidth="75" MinHeight="24"/>
            <Button x:Name="btnCancel" Content="Cancel" Click="btnCancel_Click" IsCancel="True" MinWidth="75" MinHeight="24" Margin="6,0,0,0"/>
            <Button x:Name="btnClear" Content="Clear" Click="btnClear_Click" MinWidth="75" MinHeight="24" Margin="6,0,0,0"
                    ToolTip="Remove the stored value instead of setting a new one."/>
        </StackPanel>
    </StackPanel>
</Window>
