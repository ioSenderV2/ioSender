<UserControl x:Class="CNC.Controls.ProgramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CNC.Controls"
             mc:Ignorable="d" d:DesignHeight="335" d:DesignWidth="400">
    <!-- Standalone, streamer-connectable program view: a titled host around the shared GCodeListControl.
         Owns its own G-code (Blocks) and can be Connect()'d to the streamer - see ProgramView.xaml.cs.
         One instance per Load File / wizard Generate; the connected one (stack top) runs. -->
    <DockPanel>
        <!-- Click anywhere on the title bar to toggle between the full program and the compact 3-line run view
             (previous / current / next line). Cursor + hint make it discoverable. -->
        <!-- The tooltip lists the program's remaining (TOOLPATH ..) sections, the executing one first - see
             UpdateTitleTooltip. Kept open long enough to actually read a dozen lines of it. -->
        <Border x:Name="titleBar" DockPanel.Dock="Top" Background="#FFEFEFEF" BorderBrush="#FFCCCCCC"
                BorderThickness="0,0,0,1" Padding="6,3" Visibility="Collapsed" Cursor="Hand"
                MouseLeftButtonUp="TitleBar_Click" ToolTipService.ShowDuration="60000" ToolTipService.InitialShowDelay="300">
            <DockPanel>
                <TextBlock x:Name="txtTitleHint" DockPanel.Dock="Right" Foreground="#FF888888" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <!-- Only shown when EditTargetTab is set (generated-from-a-source-tab programs, e.g. Work
                     Order) - jumps back to that tab to edit the source rather than the generated g-code. -->
                <Button x:Uid="btn_progvieweditsource" x:Name="btnEdit" DockPanel.Dock="Right" Content="Edit" Padding="8,0" Margin="8,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed" Click="BtnEdit_Click"/>
                <TextBlock x:Name="txtTitle" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>
        <!-- Live "what's running right now" status: the nearest (TOOL T=..) / (TOOLPATH ..) comment AT OR
             BEFORE the currently executing line - see ProgramView.xaml.cs UpdateRunStatus. Sticky (does not
             scroll away with the compact 3-line view below it), only shown while a run is actually in
             progress. -->
        <TextBlock x:Name="txtRunStatus" DockPanel.Dock="Top" Background="#FFF5F5F5" Foreground="#FF444444"
                   FontSize="11" Padding="6,3" TextWrapping="Wrap" Visibility="Collapsed"/>
        <local:GCodeListControl x:Name="gcodeList"/>
    </DockPanel>
</UserControl>
