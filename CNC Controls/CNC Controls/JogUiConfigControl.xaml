<UserControl x:Class="CNC.Controls.JogUiConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CNC.Controls"
             mc:Ignorable="d"
             Loaded="JogUiConfigControl_Loaded"
             d:DesignHeight="250" d:DesignWidth="310">
    <GroupBox x:Uid="grp_uiJogging" x:Name="grp_uiJog" Header="UI jogging" HeaderTemplate="{StaticResource JogHeaderTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="Auto" MinWidth="310"
              ToolTip="Four distance presets and four speed presets for the on-screen jog panel. Distance and speed are chosen with separate selectors, so any distance can be paired with any speed. 0 is the smallest/slowest, 3 the largest/fastest.">
        <StackPanel HorizontalAlignment="Stretch" Height="Auto" Margin="0,3,0,0" VerticalAlignment="Top">
            <local:NumericField x:Uid="lbl_distance3" Label="Distance 3:" ColonAt="160" Unit="mm" Format="###0.0##" Value="{Binding Path=JogUiMetric.Distance3, Mode=TwoWay}" ToolTip="On-screen jog distance preset 3 (largest step)."/>
            <local:NumericField x:Uid="lbl_distance2" Label="Distance 2:" ColonAt="160" Unit="mm" Format="###0.0##" Value="{Binding Path=JogUiMetric.Distance2, Mode=TwoWay}" ToolTip="On-screen jog distance preset 2."/>
            <local:NumericField x:Uid="lbl_distance1" Label="Distance 1:" ColonAt="160" Unit="mm" Format="###0.0##" Value="{Binding Path=JogUiMetric.Distance1, Mode=TwoWay}" ToolTip="On-screen jog distance preset 1."/>
            <local:NumericField x:Uid="lbl_distance0" Label="Distance 0:" ColonAt="160" Unit="mm" Format="###0.0##" Value="{Binding Path=JogUiMetric.Distance0, Mode=TwoWay}" ToolTip="On-screen jog distance preset 0 (smallest step)."/>
            <local:NumericField x:Uid="lbl_feedrate3" Label="Feedrate 3:" ColonAt="160" Unit="mm/min" Format="####0" Value="{Binding Path=JogUiMetric.Feedrate3, Mode=TwoWay}" ToolTip="On-screen jog speed preset 3 (fastest), selected independently of the distance."/>
            <local:NumericField x:Uid="lbl_feedrate2" Label="Feedrate 2:" ColonAt="160" Unit="mm/min" Format="####0" Value="{Binding Path=JogUiMetric.Feedrate2, Mode=TwoWay}" ToolTip="On-screen jog speed preset 2, selected independently of the distance."/>
            <local:NumericField x:Uid="lbl_feedrate1" Label="Feedrate 1:" ColonAt="160" Unit="mm/min" Format="####0" Value="{Binding Path=JogUiMetric.Feedrate1, Mode=TwoWay}" ToolTip="On-screen jog speed preset 1, selected independently of the distance."/>
            <local:NumericField x:Uid="lbl_feedrate0" Label="Feedrate 0:" ColonAt="160" Unit="mm/min" Format="####0" Value="{Binding Path=JogUiMetric.Feedrate0, Mode=TwoWay}" ToolTip="On-screen jog speed preset 0 (slowest), selected independently of the distance."/>
            <CheckBox x:Uid="lbl_keepUiJog" IsChecked="{Binding Path=Jog.KeepUiJogSelection, Mode=TwoWay}" Margin="5,0,0,3" VerticalContentAlignment="Top"
                      ToolTip="Restore the on-screen jog distance and speed selection from the previous session when ioSender starts.">
                <TextBlock x:Uid="txt_rememberJog" Text="Remember distance and speed across restarts" TextWrapping="Wrap"/>
            </CheckBox>
            <!-- Unlike everything else in this panel, this one binds to the SHARED JogViewModel rather than to
                 AppConfig - its DataContext is assigned in JogUiConfigControl_Loaded. It is the same selection
                 the on-screen jog panel's "Continuous" radio used to set; that radio is gone from the abbreviated
                 UI/Kbd Jogging panels, which left the mode reachable in code and persisted on disk but with
                 nothing anywhere to turn it on. JogViewModel.Continuous already handles both directions (off
                 restores the last discrete step) and its setter persists via "Remember..." above, so this needs
                 no config value of its own and nothing to migrate. -->
            <CheckBox x:Uid="lbl_uiJogContinuous" x:Name="chkContinuous" IsChecked="{Binding Path=Continuous, Mode=TwoWay}" Margin="5,0,0,3" VerticalContentAlignment="Top"
                      ToolTip="Hold an on-screen arrow or arrow key to jog continuously at the selected speed, instead of moving one fixed distance per press. A tap still moves one step. Shift (fast) and Ctrl+Shift (slow) jog continuously regardless of this setting.">
                <TextBlock x:Uid="txt_uiJogContinuous" Text="Continuous jogging - hold to jog" TextWrapping="Wrap"/>
            </CheckBox>
        </StackPanel>
    </GroupBox>
</UserControl>
