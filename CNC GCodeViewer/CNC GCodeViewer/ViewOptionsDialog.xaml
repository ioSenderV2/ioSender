<Window x:Class="CNC.Controls.Viewer.ViewOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CNC.Controls.Viewer"
        mc:Ignorable="d"
        d:DesignHeight="300" d:DesignWidth="300"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" MinWidth="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="View options">
    <!-- A thin window around the shared options control, which is the same instance of the same markup
         Settings > User Interface > 3D View shows. Only the two things that belong to a DIALOG are here:
         Reset view, which acts on the view this dialog was opened from, and Close. -->
    <StackPanel Margin="12">
        <local:CarveViewOptionsControl x:Uid="vo_options" x:Name="options"/>

        <Separator Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Uid="vo_reset" x:Name="btnReset" Content="Reset view" MinWidth="80" MinHeight="24"
                    ToolTip="Zoom and centre so the whole scene fits." Click="btnReset_Click"/>
            <Button x:Uid="vo_close" x:Name="btnClose" Content="Close" IsDefault="True" IsCancel="True"
                    MinWidth="80" MinHeight="24" Margin="8,0,0,0" Click="btnClose_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
