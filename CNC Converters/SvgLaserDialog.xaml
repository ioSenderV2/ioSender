<Window x:Class="CNC.Converters.SvgLaserDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Controls="clr-namespace:CNC.Controls;assembly=CNC.Controls.WPF"
             xmlns:local="clr-namespace:CNC.Converters"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="345"
             Width="400" SizeToContent="Height"
             ResizeMode="CanResizeWithGrip" Icon="App.ico"
             Title="SVG to laser">

    <!--
        Width is FIXED and only the height sizes to content, which is not a cosmetic choice.
        SizeToContent="WidthAndHeight" measures with infinite available width, so a TextBlock with
        TextWrapping="Wrap" never finds a reason to wrap and the window grows to the longest single line -
        this dialog measured 674 DIP wide that way, against content needing about 340.
        Adding MaxWidth alone was not enough either: the height had already been measured against the
        unwrapped text, so the window came out 11 DIP shorter than its own content and quietly squeezed
        the tab area. Measuring at a known width settles the wrap first and the height second.
    -->

    <!--
        Three tabs rather than one column of five groups. The single column grew past the bottom of a
        short screen, and with SizeToContent and no ScrollViewer that put OK and Cancel somewhere
        unreachable - see the code-behind for the height clamp that now stops it.

        What does NOT go in a tab: "Before you run this", because which corner to jog to is the one
        instruction that ruins the material if it is missed, and a tab you are not on hides it. The
        buttons stay outside the scrolling region for the same reason.
    -->

    <Grid Background="#FFE5E5E5" Margin="6,6,6,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            Deliberately NO MinHeight. SizeToContent hands this window a client area a few DIP smaller
            than its own content asks for (measured: 11 DIP, constant, independent of what is on the
            tabs). A Grid resolves that shortfall out of its STAR row - but a MinHeight there is a floor
            the child refuses to go below, so the overflow lands on the Auto rows underneath instead and
            pushes the buttons off the bottom. Which is the original complaint, reproduced by the fix
            for it.

            Without the floor the shortfall lands on the ScrollViewer, where it costs a scrollbar and
            nothing else. The window resizes a little as tabs are switched; that is the price, and it is
            a much better one than an unreachable OK.
        -->
        <TabControl Grid.Row="0" x:Name="tabs" MinWidth="332">

            <TabItem x:Uid="tab_svglaser_artwork" Header="Artwork">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,8,4,6">

                        <StackPanel Orientation="Horizontal" Margin="6,0,0,8">
                            <TextBlock x:Uid="lbl_svglaser_file" Text="File:" Width="88" FontSize="11" Foreground="#586069" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtFile" Text="{Binding Path=FileName, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="215" VerticalAlignment="Center"
                                       ToolTip="{Binding Path=FilePath, Mode=OneWay}"/>
                        </StackPanel>

                        <Controls:NumericField x:Uid="fld_svglaser_width" Label="Width:" ColonAt="90" Unit="mm" Format="###0.###" Value="{Binding Path=WidthMm, Mode=TwoWay}"/>
                        <TextBlock x:Name="txtHeight" TextWrapping="Wrap" Text="{Binding Path=HeightSummary, Mode=OneWay}" Foreground="#586069" FontSize="11" Margin="94,0,0,8"/>

                        <TextBlock x:Uid="txt_svglaser_placenote" TextWrapping="Wrap" Margin="6,2,6,6" FontSize="11" Foreground="#586069"
                                   Text="The artwork is measured from its own outline, so with no offset it starts exactly at the origin."/>
                        <CheckBox x:Uid="chk_svglaser_anchor" x:Name="chkAnchor" Content="Origin is the back-left corner" Margin="8,2,0,6" IsChecked="{Binding Path=AnchorBackLeft, Mode=TwoWay}"
                                  ToolTip="Tick for a machine homed to its back-left corner, where the table lies at negative Y - the artwork's TOP-left corner goes on the origin and the job runs toward the front. Clear it for an ordinary work origin at the front-left of the stock, where the job runs toward the back."/>
                        <Controls:NumericField x:Uid="fld_svglaser_originx" Label="Origin X:" ColonAt="90" Unit="mm" Format="-####0.0##" Value="{Binding Path=OriginX, Mode=TwoWay}"/>
                        <Controls:NumericField x:Uid="fld_svglaser_originy" Label="Origin Y:" ColonAt="90" Unit="mm" Format="-####0.0##" Value="{Binding Path=OriginY, Mode=TwoWay}"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Uid="tab_svglaser_copies" Header="Copies">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,8,4,6">

                        <TextBlock x:Uid="txt_svglaser_copiesnote" TextWrapping="Wrap" Margin="6,2,6,6" FontSize="11" Foreground="#586069"
                                   Text="Repeat the same artwork across a fixture, each copy a pitch further on than the one before. One drawing stays the single source of the shape."/>

                        <Controls:NumericField x:Uid="fld_svglaser_copies" Label="Copies:" ColonAt="90" Unit="" Format="##0" Value="{Binding Path=Copies, Mode=TwoWay}"
                                               ToolTip="Repeat the same artwork this many times, each one a pitch further on. One drawing stays the single source of the shape."/>
                        <Controls:NumericField x:Uid="fld_svglaser_pitchx" Label="Pitch X:" ColonAt="90" Unit="mm" Format="-####0.0##" Value="{Binding Path=PitchX, Mode=TwoWay}"/>
                        <Controls:NumericField x:Uid="fld_svglaser_pitchy" Label="Pitch Y:" ColonAt="90" Unit="mm" Format="-####0.0##" Value="{Binding Path=PitchY, Mode=TwoWay}"/>
                        <TextBlock x:Name="txtPlacement" Text="{Binding Path=PlacementSummary, Mode=OneWay}" Foreground="#586069" FontSize="11" Margin="94,6,4,4" TextWrapping="Wrap"
                                   ToolTip="Where the far corner of the last copy lands. Check it against the machine travel - a modest pitch can still add up to a reach that does not fit."/>

                        <TextBlock x:Uid="txt_svglaser_pitchnote" TextWrapping="Wrap" Margin="6,8,6,4" FontSize="11" Foreground="#586069"
                                   Text="Pitch is signed. On a back-left origin the table lies at negative Y, so stacking copies front-to-back needs a negative Pitch Y."/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Uid="tab_svglaser_burn" Header="Burn">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,8,4,6">

                        <CheckBox x:Uid="chk_svglaser_beam" x:Name="chkBeam" Content="Enable beam" Margin="8,2,0,6" IsChecked="{Binding Path=BeamOn, Mode=TwoWay}"
                                  ToolTip="Untick for a dry run: the head follows the entire path at the same feeds, so you can watch where the job lands, but every S word is 0 and the laser is never enabled. Not remembered between imports - it comes back ticked every time."/>

                        <Controls:NumericField x:Uid="fld_svglaser_power" Label="Power (S):" ColonAt="90" Unit="" Format="###0" Value="{Binding Path=Power, Mode=TwoWay}"/>
                        <TextBlock x:Name="txtPower" TextWrapping="Wrap" Text="{Binding Path=PowerSummary, Mode=OneWay}" Foreground="#586069" FontSize="11" Margin="94,0,0,4"/>
                        <Controls:NumericField x:Uid="fld_svglaser_feed" Label="Feed:" ColonAt="90" Unit="mm/min" Format="###0" Value="{Binding Path=Feed, Mode=TwoWay}"/>
                        <TextBlock x:Name="txtExposure" TextWrapping="Wrap" Text="{Binding Path=ExposureSummary, Mode=OneWay}" Foreground="#586069" FontSize="11" Margin="94,0,0,4"
                                   ToolTip="Power divided by feed - how much beam energy lands per mm travelled. This is what decides whether wood browns or chars; the S value alone does not."/>
                        <Controls:NumericField x:Uid="fld_svglaser_travel" Label="Travel:" ColonAt="90" Unit="mm/min" Format="###0" Value="{Binding Path=TravelFeed, Mode=TwoWay}"/>
                        <Controls:NumericField x:Uid="fld_svglaser_passes" Label="Passes:" ColonAt="90" Unit="" Format="##0" Value="{Binding Path=Passes, Mode=TwoWay}"/>
                        <CheckBox x:Uid="chk_svglaser_dynamic" x:Name="chkDynamic" Content="M4 dynamic power" Margin="8,6,0,2" IsChecked="{Binding Path=Dynamic, Mode=TwoWay}"
                                  ToolTip="Scales power with speed, so corners are not burned dark as the machine decelerates into them. Needs $32=1. Uncheck for M3 constant power, which suits cutting through more than engraving."/>

                        <GroupBox x:Uid="grp_svglaser_fill" Header="Shading" Margin="4,8,4,0">
                            <StackPanel>
                                <CheckBox x:Uid="chk_svglaser_fill" x:Name="chkFill" Content="Fill enclosed areas" Margin="8,4,0,2" IsChecked="{Binding Path=Fill, Mode=TwoWay}"
                                          ToolTip="Scan back and forth across the inside of each shape instead of only tracing its boundary. Holes and counters are left unburned. Adds significant time - see the estimate below."/>
                                <StackPanel x:Name="pnlFill" IsEnabled="{Binding Path=Fill, Mode=OneWay}">
                                    <Controls:NumericField x:Uid="fld_svglaser_interval" Label="Interval:" ColonAt="90" Unit="mm" Format="0.###" Value="{Binding Path=Interval, Mode=TwoWay}"/>
                                    <Controls:NumericField x:Uid="fld_svglaser_fillpower" Label="Fill power:" ColonAt="90" Unit="" Format="###0" Value="{Binding Path=FillPower, Mode=TwoWay}"/>
                                    <Controls:NumericField x:Uid="fld_svglaser_fillfeed" Label="Fill feed:" ColonAt="90" Unit="mm/min" Format="###0" Value="{Binding Path=FillFeed, Mode=TwoWay}"/>
                                    <TextBlock x:Name="txtFillExposure" TextWrapping="Wrap" Text="{Binding Path=FillExposureSummary, Mode=OneWay}" Foreground="#586069" FontSize="11" Margin="94,0,0,4"
                                               ToolTip="The shading's burn against the outline's. Raising fill power while the fill feed runs faster can leave this unchanged - which is invisible from the S values alone."/>
                                    <TextBlock x:Name="txtFill" TextWrapping="Wrap" Text="{Binding Path=FillSummary, Mode=OneWay}" Foreground="#586069" FontSize="11" Margin="94,0,0,4"/>
                                    <CheckBox x:Uid="chk_svglaser_outlineafter" x:Name="chkOutlineAfter" Content="Trace outline after shading" Margin="8,2,0,4" IsChecked="{Binding Path=OutlineAfterFill, Mode=TwoWay}"
                                              ToolTip="Burn the boundary once the shading is done, so the edge lands crisp on top of it. Untick to shade only."/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <GroupBox x:Uid="grp_svglaser_origin" Grid.Row="1" Header="Before you run this" Margin="0,6,0,0">
            <StackPanel>
                <TextBlock x:Uid="txt_svglaser_origin" TextWrapping="Wrap" Margin="4,2,4,2" FontSize="11"
                           Text="The head's position when the job starts becomes 0,0 - no homing needed."/>
                <TextBlock x:Name="txtAnchorNote" Text="{Binding Path=AnchorSummary, Mode=OneWay}" TextWrapping="Wrap" Margin="4,4,4,2" FontSize="11" Foreground="#586069"/>
                <TextBlock x:Name="txtBeamNote" Text="{Binding Path=BeamSummary, Mode=OneWay}" TextWrapping="Wrap" Margin="4,4,4,2" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock x:Name="txtLaserMode" Text="{Binding Path=LaserModeSummary, Mode=OneWay}" TextWrapping="Wrap" Margin="4,4,4,2" FontSize="11"/>
            </StackPanel>
        </GroupBox>

        <!-- Right margin clears the resize grip, which otherwise sits on top of Cancel. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,16,4">
            <Button x:Uid="btn_svglaser_ok" x:Name="btnOk" Content="OK" IsDefault="True" MinWidth="75" Height="24" Margin="0,0,6,0" Click="btnOk_Click"/>
            <Button x:Uid="btn_svglaser_cancel" x:Name="btnCancel" Content="Cancel" IsCancel="True" MinWidth="75" Height="24"/>
        </StackPanel>

    </Grid>
</Window>
