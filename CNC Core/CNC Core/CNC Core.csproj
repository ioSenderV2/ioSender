    <!-- Feeds & Speeds export/apply JSON (FeedsSpeedsExport.cs) - no JSON library existed in the solution
         before this; net462 needs the package (it's not part of the base framework there). -->
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
  </ItemGroup>
  <ItemGroup>
    <!-- Parsed at runtime by LibStrings.cs (System.Xml.Linq), NOT markup-compiled. Keeping this as a
         <Page> is what forced CNC.Core to be a WPF project (ProjectTypeGuids + Microsoft.WinFx.targets,
         which silently re-injects PresentationCore/PresentationFramework/WindowsBase/System.Xaml) and
         so blocked a .NET 8 target. The x:Uid/x:Key pairs are unchanged, so the
         Locale/<loc>/csv/CNC.Core.resources.*.csv rows and tools/locadd.py still apply. -->
    <EmbeddedResource Include="LibStrings.xaml" />
    <!-- ATC support macros, embedded for auto-provisioning (AtcMacros.cs). LogicalName = bare file name.
         They live in THIS assembly because AtcMacros reads them via GetExecutingAssembly. -->
    <EmbeddedResource Include="..\..\macros\pcorner.macro"><LogicalName>pcorner.macro</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\macros\pvisecorner.macro"><LogicalName>pvisecorner.macro</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\macros\pcenter.macro"><LogicalName>pcenter.macro</LogicalName></EmbeddedResource>
