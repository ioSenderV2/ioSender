  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{F245FF89-A838-4D6E-AA40-92CFD3D072D3}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>CNC.Core</RootNamespace>
    <AssemblyName>CNC.Core</AssemblyName>
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <WarningLevel>4</WarningLevel>
    <TargetFrameworkProfile />
    <!-- The ATC .macro files are EmbeddedResources from ..\..\macros\ (outside this project). VS's fast
         up-to-date check ignores external files, so a normal Build skips re-embedding edited macros (leaving
         stale embedded/seeded/uploaded copies). Disabling it forces the real up-to-date check, which tracks
         the EmbeddedResource inputs - so editing a macro + Build re-embeds it without needing a Clean. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;RESPONSELOG  USEWEBSOCKET xUSEELTIMA</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE;USEWEBSOCKET</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup>
    <UICulture>en-US</UICulture>
  </PropertyGroup>
  <ItemGroup>
    <!-- NO WPF REFERENCES HERE, deliberately: PresentationCore, PresentationFramework, WindowsBase,
         System.Xaml and System.Windows.Forms were all removed once the last WPF usage left this project
         (pr/portable-core). CNC.Core is the portable half - if you find yourself adding one of these back,
         the type you want belongs in CNC.Controls behind a hook instead (see UserPrompt, UiContext,
         EventUtils.Pump, GrblViewModel.KeyboardFactory for the established pattern). -->
    <!-- RP.Math dropped: its only use here was three lines of WCS rotation in GCodeEmulator, now
         Point3D.RotateZ (verified numerically identical against the assembly over 3100 rotations).
         It was an external net462-only DLL whose source is no longer present on this machine - the
         build only still resolved it from a stale copy in bin\. The WPF projects still use it. -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <!-- System.Management dropped: the WMI COM-port description lookup moved to
         CNC.Controls.SerialPortDescriptions (WMI compiles anywhere but is Windows-only at runtime).
         Port ENUMERATION stays here - it must run where the hardware is. -->
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <!-- websocket-sharp is GONE from Core: WebsocketStream now uses System.Net.WebSockets.ClientWebSocket,
         which is in the framework on both net462 and net8.0. CNC.Controls keeps its own reference for
         ObsBridge (OBS Studio's protocol, client functionality). Don't add it back here. -->
  </ItemGroup>
  <ItemGroup>
    <!-- The wire contract (step 6 of the client/server split). The machine-facing enums and the
         GrblState struct live there now (same namespaces, so no call-site changes); Core builds its
         working state out of contract types. Reference direction is one-way: everything may reference
         CNC.Contracts, CNC.Contracts references nothing. -->
    <ProjectReference Include="..\..\CNC Contracts\CNC.Contracts.csproj">
      <Project>{9448A265-0B77-4235-A5F5-BDE212EC75E7}</Project>
      <Name>CNC.Contracts</Name>
    </ProjectReference>
  </ItemGroup>
