<?xml version="1.0" encoding="utf-8"?>
<!--
  ioSender factory-default settings template.

  This is the source of "Reset to Default" for the App / Jogging / G Code settings tabs, and the seed for a
  brand-new install (copied to %AppData%\ioSender\App.config on first run when no user config exists yet).
  It is read-only at runtime - ioSender never writes here; all user edits go to the per-user App.config.

  Edit these values to change the shipped defaults. Only the keys a settings panel can reset need to be present;
  any key omitted here falls back to its built-in code default. Keep the <AppConfig>/<section>/<Config> shape.
-->
<AppConfig version="2">
  <section key="Core">
    <Config>
      <Theme>default</Theme>
      <PollInterval>200</PollInterval>
      <ResetDelay>2000</ResetDelay>
      <MaxBufferSize>300</MaxBufferSize>
      <UseBuffering>false</UseBuffering>
      <KeepMdiFocus>true</KeepMdiFocus>
      <FilterOkResponse>false</FilterOkResponse>
      <AutoCompress>false</AutoCompress>
      <KeepWindowSize>false</KeepWindowSize>
      <SendComments>false</SendComments>
      <PreferNetwork>true</PreferNetwork>
      <AddLineNumbers>false</AddLineNumbers>
      <AutoSaveSettings>false</AutoSaveSettings>
      <PromptOnSave>false</PromptOnSave>
      <AutoSaveGrblSettings>false</AutoSaveGrblSettings>
      <PromptOnGrblSave>false</PromptOnGrblSave>
      <SafeGotoZ>true</SafeGotoZ>
      <IgnoreM6>No</IgnoreM6>
      <IgnoreM7>No</IgnoreM7>
      <IgnoreM8>No</IgnoreM8>
      <IgnoreG61G64>Strip</IgnoreG61G64>
    </Config>
  </section>
  <section key="Jog">
    <JogConfig>
      <KeyboardEnable>true</KeyboardEnable>
      <KeepUiJogSelection>false</KeepUiJogSelection>
      <DefaultSpeedFast>false</DefaultSpeedFast>
      <FastFeedrate>500</FastFeedrate>
      <SlowFeedrate>200</SlowFeedrate>
      <StepFeedrate>100</StepFeedrate>
      <FastDistance>500</FastDistance>
      <SlowDistance>500</SlowDistance>
      <StepDistance>0.05</StepDistance>
    </JogConfig>
  </section>
  <section key="JogUiMetric">
    <JogUIConfig>
      <Feedrate0>5</Feedrate0>
      <Feedrate1>100</Feedrate1>
      <Feedrate2>500</Feedrate2>
      <Feedrate3>1000</Feedrate3>
      <Distance0>0.01</Distance0>
      <Distance1>0.1</Distance1>
      <Distance2>1</Distance2>
      <Distance3>10</Distance3>
    </JogUIConfig>
  </section>
  <!-- Work Order tools (CNC.Controls.CustomTool.cs) - the factory-default bit set. Ids 0-13 match the
       retired OddJobsTool enum's own ordinals exactly, so a work order saved before this section existed
       still resolves to the same tool. Absent from an existing user App.config, this whole section is
       promoted in automatically (ConfigStore.ReadDocument's template-fallback path) the first time that
       user's build reads it; an operator can then rename/retune/delete any entry freely from Settings:App >
       Work Order - there is no protected/read-only tier. -->
  <section key="CustomTools">
    <CustomToolList>
      <Entries>
        <CustomTool>
          <Id>0</Id>
          <Name>1/4" 2-flute endmill</Name>
          <Kind>EndMill</Kind>
          <DiameterMm>6.35</DiameterMm>
          <Flutes>2</Flutes>
        </CustomTool>
        <CustomTool>
          <Id>1</Id>
          <Name>1/4" 3-flute roughing endmill</Name>
          <Kind>EndMill</Kind>
          <DiameterMm>6.35</DiameterMm>
          <Flutes>3</Flutes>
        </CustomTool>
        <CustomTool>
          <Id>2</Id>
          <Name>1/4" O-flute</Name>
          <Kind>OFlute</Kind>
          <DiameterMm>6.35</DiameterMm>
          <Flutes>1</Flutes>
        </CustomTool>
        <CustomTool>
          <Id>3</Id>
          <Name>1/4" Ball end</Name>
          <Kind>BallEnd</Kind>
          <DiameterMm>6.35</DiameterMm>
          <Flutes>2</Flutes>
        </CustomTool>
        <CustomTool>
          <Id>4</Id>
          <Name>25mm 2-flute surfacing bit</Name>
          <Kind>Surfacing</Kind>
          <DiameterMm>25</DiameterMm>
          <Flutes>2</Flutes>
        </CustomTool>
        <CustomTool>
          <Id>5</Id>
          <Name>45 deg V-bit (chamfer)</Name>
          <Kind>VBitOrChamfer</Kind>
          <DiameterMm>6.35</DiameterMm>
          <Flutes>2</Flutes>
        </CustomTool>
        <CustomTool>
          <Id>6</Id>
          <Name>1/8" 2-flute endmill</Name>
          <Kind>EndMill</Kind>
          <DiameterMm>3.175</DiameterMm>
          <Flutes>2</Flutes>
        </CustomTool>
        <CustomTool>
          <Id>7</Id>
          <Name>1/8" Ball end</Name>
          <Kind>BallEnd</Kind>
          <DiameterMm>3.175</DiameterMm>
          <Flutes>2</Flutes>
        </CustomTool>
        <CustomTool>
          <Id>8</Id>
          <Name>Drill bit (size = hole)</Name>
          <Kind>Drill</Kind>
          <DiameterMm>6.35</DiameterMm>
          <Flutes>2</Flutes>
        </CustomTool>
        <CustomTool>
          <Id>9</Id>
          <Name>3/8" (10mm) countersink bit</Name>
          <Kind>Countersink</Kind>
          <DiameterMm>9.525</DiameterMm>
          <Flutes>1</Flutes>
          <DefaultRpm>8000</DefaultRpm>
        </CustomTool>
        <CustomTool>
          <Id>10</Id>
          <Name>9/16" (14mm) countersink bit</Name>
          <Kind>Countersink</Kind>
          <DiameterMm>14.2875</DiameterMm>
          <Flutes>1</Flutes>
          <DefaultRpm>8000</DefaultRpm>
        </CustomTool>
        <CustomTool>
          <Id>11</Id>
          <Name>13/16" (21mm) countersink bit</Name>
          <Kind>Countersink</Kind>
          <DiameterMm>20.6375</DiameterMm>
          <Flutes>1</Flutes>
          <DefaultRpm>8000</DefaultRpm>
        </CustomTool>
        <CustomTool>
          <Id>12</Id>
          <Name>1-1/8" (28mm) countersink bit</Name>
          <Kind>Countersink</Kind>
          <DiameterMm>28.575</DiameterMm>
          <Flutes>1</Flutes>
          <DefaultRpm>8000</DefaultRpm>
        </CustomTool>
        <CustomTool>
          <Id>13</Id>
          <Name>1/4" 4-flute chamfer bit (90 deg)</Name>
          <Kind>VBitOrChamfer</Kind>
          <DiameterMm>6.35</DiameterMm>
          <Flutes>4</Flutes>
        </CustomTool>
      </Entries>
    </CustomToolList>
  </section>
</AppConfig>
