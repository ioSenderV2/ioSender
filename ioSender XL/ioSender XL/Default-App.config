<?xml version="1.0" encoding="utf-8"?>
<!--
  ioSender factory-default settings template.

  This is the source of "Reset to Default" for the App / Jogging / G Code settings tabs, and the seed for a
  brand-new install (copied to %AppData%\ioSender\App.config on first run when no user config exists yet).
  It is read-only at runtime - ioSender never writes here; all user edits go to the per-user App.config.

  Edit these values to change the shipped defaults. Only the keys a settings panel can reset need to be present;
  any key omitted here falls back to its built-in code default. Keep the <AppConfig>/<section>/<Config> shape.
-->
<AppConfig version="2">
  <section key="Core">
    <Config>
      <Theme>default</Theme>
      <PollInterval>200</PollInterval>
      <SafeGotoZ>true</SafeGotoZ>
      <PortParams></PortParams>
      <NetworkHost></NetworkHost>
      <PreferNetwork>false</PreferNetwork>
      <UiScale>1</UiScale>
      <ResetDelay>2000</ResetDelay>
      <StartSimulator>false</StartSimulator>
      <SimulatorExe>grblHAL_sim.exe</SimulatorExe>
      <SimulatorArgs />
      <SimulatorSpeedup>1</SimulatorSpeedup>
      <LastFirmwareBuild></LastFirmwareBuild>
      <TloRefBaseline>0</TloRefBaseline>
      <ProbeDefinitionsReviewed>false</ProbeDefinitionsReviewed>
      <WorkOrderDirty>false</WorkOrderDirty>
      <UseFriendlyRunLabels>false</UseFriendlyRunLabels>
      <ShowJogTargetButtons>false</ShowJogTargetButtons>
      <ShowJobJogPad>true</ShowJobJogPad>
      <ShowJobSplitView>false</ShowJobSplitView>
      <JobSplitRatio>0.5</JobSplitRatio>
      <UseBuffering>false</UseBuffering>
      <KeepWindowSize>true</KeepWindowSize>
      <WindowWidth>-1</WindowWidth>
      <WindowHeight>-1</WindowHeight>
      <WindowLeft>97.777777777777771</WindowLeft>
      <WindowTop>122.66666666666666</WindowTop>
      <OutlineFeedRate>500</OutlineFeedRate>
      <MaxBufferSize>300</MaxBufferSize>
      <Editor>notepad.exe</Editor>
      <KeepMdiFocus>true</KeepMdiFocus>
      <FilterOkResponse>false</FilterOkResponse>
      <AutoCompress>false</AutoCompress>
      <SendComments>false</SendComments>
      <AddLineNumbers>false</AddLineNumbers>
      <ConsoleVerbose>false</ConsoleVerbose>
      <ConsoleFilterRT>false</ConsoleFilterRT>
      <ConsoleShowRTAll>false</ConsoleShowRTAll>
      <ConsoleWindowOpen>false</ConsoleWindowOpen>
      <ConsoleShortcut>F12</ConsoleShortcut>
      <ConsoleShortcutEscMigrated>true</ConsoleShortcutEscMigrated>
      <ConsoleFontSize>10</ConsoleFontSize>
      <LastMachine />
      <FeedsAndSpeedsIntroShown>true</FeedsAndSpeedsIntroShown>
      <ConsoleWindowLeft>NaN</ConsoleWindowLeft>
      <ConsoleWindowTop>NaN</ConsoleWindowTop>
      <ConsoleWindowWidth>NaN</ConsoleWindowWidth>
      <ConsoleWindowHeight>NaN</ConsoleWindowHeight>
      <StatusWindowLeft>NaN</StatusWindowLeft>
      <StatusWindowTop>NaN</StatusWindowTop>
      <StatusWindowWidth>NaN</StatusWindowWidth>
      <StatusWindowHeight>NaN</StatusWindowHeight>
      <StatusWindowAutoCloseSeconds>10</StatusWindowAutoCloseSeconds>
      <TabShortcuts />
      <ActionShortcuts>
        <TabShortcut>
          <Id>UiScaleUp</Id>
          <Key>Control+Alt+OemPlus</Key>
        </TabShortcut>
        <TabShortcut>
          <Id>UiScaleDown</Id>
          <Key>Control+Alt+OemMinus</Key>
        </TabShortcut>
        <TabShortcut>
          <Id>Screenshot</Id>
          <Key>Control+Alt+F6</Key>
        </TabShortcut>
        <TabShortcut>
          <Id>ObsCamAStart</Id>
          <Key>Control+Alt+F9</Key>
        </TabShortcut>
        <TabShortcut>
          <Id>ObsCamAStop</Id>
          <Key>Control+Alt+F10</Key>
        </TabShortcut>
        <TabShortcut>
          <Id>ObsCamBStart</Id>
          <Key>Control+Alt+F11</Key>
        </TabShortcut>
        <TabShortcut>
          <Id>ObsCamBStop</Id>
          <Key>Control+Alt+F12</Key>
        </TabShortcut>
        <TabShortcut>
          <Id>ObsAppStart</Id>
          <Key>Control+Alt+F7</Key>
        </TabShortcut>
        <TabShortcut>
          <Id>ObsAppStop</Id>
          <Key>Control+Alt+F8</Key>
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.Connect</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.LoadProgram</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.LoadWorkOrder</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.NewWorkOrder</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.Camera</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.Wiki</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.UsageTips</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.BriefTour</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.VideoTutorials</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.ErrorCodes</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.CheckForUpdates</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.RollBack</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.OpenDataFolder</Id>
          <Key />
        </TabShortcut>
        <TabShortcut>
          <Id>Menu.About</Id>
          <Key />
        </TabShortcut>
      </ActionShortcuts>
      <IgnoreM6>No</IgnoreM6>
      <IgnoreM7>No</IgnoreM7>
      <IgnoreM8>No</IgnoreM8>
      <IgnoreG61G64>Strip</IgnoreG61G64>
      <Macros />
      <LastMacroId>-1</LastMacroId>
      <MainPanelsKeys>UIJogging,KeyboardJogging,Goto,WorkParameters,Macros</MainPanelsKeys>
      <FlyoutItemsKeys>ProgramLimits</FlyoutItemsKeys>
      <LeftPanelsKeys>DRO,MachinePosition,Feed,Spindle,Coolant</LeftPanelsKeys>
      <TabsKeys>GRBLConfig,FeedsAndSpeeds,StartJob,GRBL,Offsets,SDCard,WorkOrder,MachineSetup,LatheWizards</TabsKeys>
      <HiddenViewsKeys />
      <HeightMapTabMigrated>true</HeightMapTabMigrated>
      <StartJobTabFirstMigrated>true</StartJobTabFirstMigrated>
      <PinnedFlyouts />
      <PinnedMacros />
      <AutoSaveSettings>false</AutoSaveSettings>
      <PromptOnSave>false</PromptOnSave>
      <AutoSaveGrblSettings>false</AutoSaveGrblSettings>
      <PromptOnGrblSave>false</PromptOnGrblSave>
      <AutoSaveWorkOrderOnExit>true</AutoSaveWorkOrderOnExit>
      <PromptBeforeAutoSaveWorkOrder>false</PromptBeforeAutoSaveWorkOrder>
      <SpindleDirectionCapability>Bidirectional</SpindleDirectionCapability>
    </Config>
  </section>
  <section key="Jog">
    <JogConfig>
      <KeyboardEnable>true</KeyboardEnable>
      <KeepUiJogSelection>true</KeepUiJogSelection>
      <DefaultSpeedFast>false</DefaultSpeedFast>
      <FastFeedrate>500</FastFeedrate>
      <SlowFeedrate>200</SlowFeedrate>
      <StepFeedrate>100</StepFeedrate>
      <FastDistance>500</FastDistance>
      <SlowDistance>500</SlowDistance>
      <StepDistance>0.05</StepDistance>
    </JogConfig>
  </section>
