<UserControl x:Class="GCode_Sender.StartJobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cnccontrols="clr-namespace:CNC.Controls;assembly=CNC.Controls.WPF"
             xmlns:probing="clr-namespace:CNC.Controls.Probing;assembly=CNC.Controls.Probing"
             mc:Ignorable="d" d:DesignHeight="560" d:DesignWidth="720">
    <UserControl.Resources>
        <cnccontrols:BoolToVisibleConverter x:Key="ToVisibleConverter"/>
        <probing:EnumValueToVisibleConverter x:Key="ProbeEdgeVisibleConverter"/>
        <!-- Red X overlay shown on the Geometry picker once a cell is selected - marks where to actually
             place the probe (NOT the green dot's own position, which is just the picker icon's corner/edge
             point). Corner picks: X sits on the diagonal through that corner - out past it for External,
             in past it toward the grid centre for Internal. Edge picks: X sits straight out/in from that
             side. Same MultiBinding-visibility idiom as EdgeFinderControl's existing red Z-probe squares. -->
        <Style x:Key="XMark" TargetType="Path">
            <Setter Property="Data" Value="M0,0 L16,16 M16,0 L0,16"/>
            <Setter Property="Stroke" Value="Red"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10" Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <!-- Proportional (min 1/3 of the window), not a hardcoded pixel width - a fixed Width="360" here
                 used to stay pinned at that pixel width regardless of window size, so widening the window just
                 gave the Stock drawing (right column) all the extra space, squeezing the setup fields'
                 wrapped/truncated text into an ever-smaller fraction of a wide window. -->
            <ColumnDefinition Width="1*" MinWidth="360"/>
            <!-- Splitter gets its OWN column, not "sit on the col 0/1 boundary" - the latter puts the splitter
                 BEHIND column 0's content in z-order (declared first in XAML), and that content (the
                 ScrollViewer/GroupBox) has no margin carved out for it, so it swallows the splitter's hit-test
                 area entirely - confirmed on real hardware: no resize cursor ever appeared. A dedicated column
                 is the same fix the Job tab's two splitters already use successfully. -->
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#FFCCCCCC" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

        <!-- Left: scrolling inputs on top, warnings/result + Generate/Run pinned at the bottom-left -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <GroupBox x:Uid="ls_grpSetup" Header="Setup">
                        <StackPanel Margin="6">
                            <!-- Corner is always the front-left (TFL); the tip radius + feeds come
                                 straight from the configured 3D probe definition. Fixtures - including their
                                 saved position - are defined in Machine Setup > Fixture definitions; here you
                                 only pick one with a VALIDATED (Test position) result. Probe type sits on the
                                 same row (it's global, not fixture-specific, so it doesn't need fixture-gating).
                                 DockPanel (not a plain horizontal StackPanel) so Fixture stays glued to its own
                                 dropdown on the left while Probe pins flush to the panel's right edge - both
                                 labels still start at the same left-hand x as "Safe Z delta:" below, since
                                 that's just a matter of both rows sharing the same left origin, not a shared
                                 fixed-width label column. -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Label x:Uid="ls_lblFixture" Content="Fixture:" Padding="0" VerticalAlignment="Center"/>
                                    <ComboBox x:Uid="cbxFixture" x:Name="cbxFixture" MinWidth="140" MinHeight="22" Margin="4,0,0,0" VerticalAlignment="Center"
                                              DisplayMemberPath="Name" SelectionChanged="cbxFixture_SelectionChanged"
                                              ToolTip="Fixture to reference for this job (defined in Machine Setup Wizard &gt; Fixture definitions)."/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Label x:Uid="ls_lblProbe" Content="Probe:" Padding="0" VerticalAlignment="Center"/>
                                    <ComboBox x:Uid="cbxProbeType" x:Name="cbxProbeType" MinWidth="120" MinHeight="22" Margin="4,0,0,0" VerticalAlignment="Center" SelectedIndex="0">
                                        <ComboBoxItem x:Uid="cbiProbe3d" x:Name="cbiProbe3d" Content="3D Probe"/>
                                        <ComboBoxItem x:Uid="cbiProbeTouch" x:Name="cbiProbeTouch" Content="Touch Plate"
                                                      ToolTip="Probes by electrical continuity - works on conductive stock directly, or on non-conductive stock via a separate metal touch plate (see 'Stock conductive' below)."/>
                                    </ComboBox>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="txtNoFixture" Foreground="#C0392B" TextWrapping="Wrap" Margin="4,0,0,2" FontSize="11" Visibility="Collapsed"
                                       Text="No fixture with a validated position available. Define/position/test one in Machine Setup Wizard &gt; Fixture definitions."/>
                            <TextBlock x:Name="txtFixtureWarning" Foreground="#C0392B" TextWrapping="Wrap" Margin="4,0,0,2" FontSize="11" Visibility="Collapsed"
                                       Text="This fixture type isn't supported yet."/>
                            <Separator Margin="0,4"/>
                            <!-- Everything below needs a fixture picked first (its saved reference/probe geometry is
                                 what every field here means something in terms of) - disabled as ONE block per
                                 panel (pnlSetupGated/pnlStock/pnlActions.IsEnabled, set together in
                                 UpdateFixtureWarning) rather than field-by-field, so disabling a fixture-dependent
                                 field can never be forgotten, and a disabled ANCESTOR overrides each control's own
                                 IsEnabled/binding (e.g. Rotate's own chkMeasure-driven binding) without fighting
                                 it - standard WPF subtree-disable behavior. Split across 3 panels now (Setup/
                                 Stock/Actions groupboxes), so the 3 panel roots are gated together in code
                                 instead of 1. Now just Safe Z delta (Probe moved up onto the Fixture row, above,
                                 ungated - it isn't fixture-specific). -->
                            <StackPanel x:Name="pnlSetupGated">
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                    <Label x:Uid="ls_cornermargin" Content="Safe Z delta:" Width="190" HorizontalContentAlignment="Left" VerticalAlignment="Center"/>
                                    <cnccontrols:NumericField x:Name="fldCornerMargin" Label="" ColonAt="0" Unit="mm" Format="##0.0##" Value="10"
                                                              IsEnabled="{Binding ElementName=chkMeasure, Path=IsChecked}"
                                                              ToolTip="Corners 2-4 travel at corner 1's own measured stock top plus this delta, instead of retracting fully to machine top between corners. Must clear any fence/clamp hardware between corners on this fixture."/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Geometry panel: visible only when the "Dynamic" fixture (the synthetic no-saved-
                         position entry, see G28Fixture) is selected. External/Internal + Is Circle choose
                         which of the real Probing-tab pickers to embed below - the SAME clickable grids
                         EdgeFinderControl/EdgeFinderIntControl use (Resources/*.png, Style/converters
                         duplicated here since those are UserControl-local resources, not a shared dictionary),
                         driven by geometryVm (a plain ProbingViewModel instance, code-behind-assigned as this
                         panel's DataContext - see EnsureGeometryVm) so clicking a cell sets its real ProbeEdge
                         property, same as on those tabs. Is Circle shows a plain reference picture instead
                         (External/Internal alone already says solid-boss vs hole - nothing further to click). -->
                    <GroupBox x:Uid="ls_grpGeometry" x:Name="grpGeometry" Header="Geometry" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton x:Uid="ls_geomExternal" x:Name="rbGeomExternal" Content="External" GroupName="geomInOut" IsChecked="True" Margin="0,0,12,0"/>
                                <RadioButton x:Uid="ls_geomInternal" x:Name="rbGeomInternal" Content="Internal" GroupName="geomInOut"/>
                                <CheckBox x:Uid="ls_geomIsCircle" x:Name="chkIsCircle" Content="Is Circle" Margin="24,0,0,0"/>
                            </StackPanel>

                            <!-- Outer 244x244: 32px pad around the 180x180 picker so the External X marks
                                 (drawn OUTSIDE the corner/edge) have room to render without being clipped by
                                 the enclosing StackPanel/GroupBox - a plain overflow render was tried first
                                 and silently clipped. -->
                            <Grid x:Name="pnlEdgePickerExt" Width="244" Height="244" HorizontalAlignment="Left">
                                <Grid.Resources>
                                    <cnccontrols:EnumValueToBooleanConverter x:Key="EnumToEdgeConverter"/>
                                    <Style x:Key="GeomFlag" TargetType="RadioButton">
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Width" Value="60"/>
                                        <Setter Property="Height" Value="60"/>
                                        <Setter Property="GroupName" Value="geomEdgeExt"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border Background="Transparent">
                                                        <Image Source="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>
                                <Grid Width="180" Height="180" Margin="32,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="60"/><RowDefinition Height="60"/><RowDefinition Height="60"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/cornerD.png" Style="{StaticResource GeomFlag}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=D}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/edgeCD.png" Grid.Column="1" Style="{StaticResource GeomFlag}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=CD}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/cornerC.png" Grid.Column="2" Style="{StaticResource GeomFlag}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=C}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/edgeAD.png" Grid.Row="1" Style="{StaticResource GeomFlag}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=AD}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/edgeBC.png" Grid.Row="1" Grid.Column="2" Style="{StaticResource GeomFlag}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=CB}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/cornerA.png" Grid.Row="2" Style="{StaticResource GeomFlag}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=A}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/edgeAB.png" Grid.Row="2" Grid.Column="1" Style="{StaticResource GeomFlag}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=AB}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/cornerB.png" Grid.Row="2" Grid.Column="2" Style="{StaticResource GeomFlag}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=B}"/>
                                </Grid>
                                <!-- Probe-placement X marks (External = outward, past the corner/edge). Margins are
                                     relative to THIS outer 244x244 grid, i.e. picker-local (32,32,0,0) + the same
                                     offsets used inside the 180x180 picker itself. Corner offset matches the edge
                                     offset (6) - close to the green dot, NOT the icon's own distant arrow-bend
                                     graphic (tried that from a pixel-level read of cornerA.png; wrong landmark). -->
                                <Path Style="{StaticResource XMark}" Margin="18,18,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="D"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="210,18,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="C"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="18,210,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="A"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="210,210,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="B"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="114,18,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="CD"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="18,114,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="AD"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="210,114,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="CB"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="114,210,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="AB"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                            </Grid>

                            <Grid x:Name="pnlEdgePickerInt" Width="244" Height="244" HorizontalAlignment="Left" Visibility="Collapsed">
                                <Grid.Resources>
                                    <cnccontrols:EnumValueToBooleanConverter x:Key="EnumToEdgeConverter"/>
                                    <Style x:Key="GeomFlagInt" TargetType="RadioButton">
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Width" Value="60"/>
                                        <Setter Property="Height" Value="60"/>
                                        <Setter Property="GroupName" Value="geomEdgeInt"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border Background="Transparent">
                                                        <Image Source="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>
                                <Grid Width="180" Height="180" Margin="32,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="60"/><RowDefinition Height="60"/><RowDefinition Height="60"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/cornerID.png" Style="{StaticResource GeomFlagInt}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=D}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/edgeICD.png" Grid.Column="1" Style="{StaticResource GeomFlagInt}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=CD}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/cornerIC.png" Grid.Column="2" Style="{StaticResource GeomFlagInt}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=C}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/edgeIAD.png" Grid.Row="1" Style="{StaticResource GeomFlagInt}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=AD}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/edgeIBC.png" Grid.Row="1" Grid.Column="2" Style="{StaticResource GeomFlagInt}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=CB}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/cornerIA.png" Grid.Row="2" Style="{StaticResource GeomFlagInt}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=A}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/edgeIAB.png" Grid.Row="2" Grid.Column="1" Style="{StaticResource GeomFlagInt}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=AB}"/>
                                    <RadioButton Content="/CNC.Controls.Probing;component/Resources/cornerIB.png" Grid.Row="2" Grid.Column="2" Style="{StaticResource GeomFlagInt}" IsChecked="{Binding Path=ProbeEdge, Mode=TwoWay, Converter={StaticResource EnumToEdgeConverter}, ConverterParameter=B}"/>
                                </Grid>
                                <!-- Probe-placement X marks (Internal = inward, past the corner/edge toward the grid centre).
                                     Corner marks sit ON the diagonal through that corner toward the OPPOSITE corner
                                     (equal x/y offset from the corner point, 40px along the diagonal, in outer-grid
                                     coordinates: pad 32 + local-grid offset - a previous version mixed up the pad
                                     constant per corner, which put C/A off-diagonal while D/B looked fine by
                                     coincidence, since a uniform (dx,dy) error only cancels out when dx and dy sit
                                     on the same corner's own diagonal). -->
                                <Path Style="{StaticResource XMark}" Margin="64,64,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="D"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="164,64,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="C"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="64,164,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="A"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="164,164,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="B"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="114,64,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="CD"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="64,114,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="AD"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="164,114,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="CB"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                                <Path Style="{StaticResource XMark}" Margin="114,164,0,0">
                                    <Path.Visibility>
                                        <MultiBinding Converter="{StaticResource ProbeEdgeVisibleConverter}" ConverterParameter="AB"><Binding Path="ProbeEdge"/></MultiBinding>
                                    </Path.Visibility>
                                </Path>
                            </Grid>

                            <Grid Width="120" Height="120" HorizontalAlignment="Left">
                                <Image x:Name="imgCenterPreview" Stretch="Uniform" Visibility="Collapsed"/>
                                <!-- Is Circle probes straight down AT the centre - no outward/inward offset needed,
                                     unlike the corner/edge picks above. -->
                                <Path x:Name="xmarkCenter" Style="{StaticResource XMark}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Visibility="Collapsed"/>
                            </Grid>
                            <cnccontrols:NumericField x:Name="fldCenterPasses" x:Uid="ls_centerPasses" Label="Passes:" ColonAt="55" Unit="" Format="0" Value="1" Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                                                      ToolTip="Number of times to re-probe the center, each pass re-centering on the previous result. More than one pass is usually needed for accurate dimensions - matches the old Center Finder tab's own Passes field."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Right-click this panel's header for a Show in inches/millimeters toggle (UnitToggleMenu,
                         attached in code-behind) - replaces the old rbUnitsMm/rbUnitsIn radio pair. -->
                    <GroupBox x:Uid="ls_grpStock" x:Name="grpStock" Header="Stock" Margin="0,8,0,0">
                        <StackPanel x:Name="pnlStock" Margin="6" Grid.IsSharedSizeScope="True">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <CheckBox x:Uid="ls_exactsize" x:Name="chkExactSize" Content="Stock size is exact" IsChecked="False" VerticalAlignment="Center"
                                          IsEnabled="{Binding ElementName=chkMeasure, Path=IsChecked}"
                                          ToolTip="Off (default): width/height above are a conservative ESTIMATE - a few mm larger than actual - so far-corner references land safely outside the stock. On: they are treated as exact, and corners 2-4 probe close to their computed true position instead (corner 2 assumes near-zero skew; corners 3/4 use the skew measured from corners 1-2). Faster and tighter, but a wrong entered size can miss the stock - only enable if you trust the numbers."/>
                                <CheckBox x:Uid="ls_conductive" x:Name="chkStockConductive" Content="Stock conductive" IsChecked="False" Margin="16,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Touch plate only. Checked: the tool touches the conductive stock directly, no offset. Unchecked: a separate metal touch plate is used against non-conductive stock - its ProbeDefinition PlateThickness is subtracted from the probed Z."/>
                            </StackPanel>
                            <cnccontrols:NumericField x:Name="fldWidth"     x:Uid="ls_width"     Label="Est. width (X):"     ColonAt="120" Unit="mm" Format="####0.0##" Value="100" Margin="0,6,0,2"/>
                            <cnccontrols:NumericField x:Name="fldHeight"    x:Uid="ls_height"    Label="Est. height (Y):"    ColonAt="120" Unit="mm" Format="####0.0##" Value="100" Margin="0,2"/>
                            <cnccontrols:NumericField x:Name="fldThickness" x:Uid="ls_thickness" Label="Est. thickness (Z):" ColonAt="120" Unit="mm" Format="####0.0##" Value="19"  Margin="0,2"/>
                            <cnccontrols:NumericField x:Name="fldSpacer"    x:Uid="ls_spacer"    Label="Spacer/backer (Z):"  ColonAt="120" Unit="mm" Format="####0.0##" Value="0"   Margin="0,2"
                                                      ToolTip="Sacrificial board thickness under the stock (same footprint), e.g. 1/4 in MDF a thin sheet is taped to. 0 = none. The metal top is probed for Z0; this keeps the side probe on the material, not the backer."/>
                            <TextBlock x:Name="txtThickWarn" Foreground="#C0392B" TextWrapping="Wrap" Margin="4,0,0,2" FontSize="11" Visibility="Collapsed"
                                       Text="Stock over 1 in (25.4 mm) thick - the probe macros assume 1 in or less and will miss the top of taller stock."/>
                            <TextBlock x:Name="txtSizeHint" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="4,0,0,2" FontSize="22"
                                       Text="Actual stock size."/>
                            <Button x:Name="btnCopyFromStock" x:Uid="ls_copyFromStock" Content="Copy from loaded program's STOCK" HorizontalAlignment="Left"
                                    Margin="4,2,0,2" Padding="6,2" FontSize="11" Visibility="Collapsed" Click="CopyFromStock_Click"
                                    ToolTip="The loaded program's own (STOCK X=.. Y=.. Z=..) comment differs from the values above - click to copy it in."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Uid="ls_grpActions" Header="Actions" Margin="0,8,0,0">
                        <StackPanel x:Name="pnlActions" Margin="6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <CheckBox x:Uid="ls_setorigin" x:Name="chkSetOrigin" Content="Set origin or offset:" IsChecked="True" VerticalAlignment="Center"
                                          ToolTip="On (default): the generated program commits the probed/measured position as this WCS's origin (and its rotation, if Set work rotation from skew is on), or as a G92 temporary offset if G92 is selected. Off: still probes/measures and reports the numbers, but leaves the selected WCS/offset untouched."/>
                                <ComboBox x:Uid="cbxWcs" x:Name="cbxWcs" MinWidth="80" MinHeight="22" Margin="6,0,0,0" VerticalAlignment="Center" SelectedIndex="0"
                                          IsEnabled="{Binding ElementName=chkSetOrigin, Path=IsChecked}"
                                          ToolTip="Work coordinate system (G54-G59) to set this job's origin in, or G92 for a temporary offset instead of a persistent WCS origin.">
                                    <ComboBoxItem Content="G54"/>
                                    <ComboBoxItem Content="G55"/>
                                    <ComboBoxItem Content="G56"/>
                                    <ComboBoxItem Content="G57"/>
                                    <ComboBoxItem Content="G58"/>
                                    <ComboBoxItem Content="G59"/>
                                    <ComboBoxItem x:Name="cbiG92" Content="G92"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Uid="ls_tloref" x:Name="chkSetTloRef" Content="Set tool-length reference" IsChecked="True" Margin="0,2,0,2" VerticalAlignment="Center"
                                      ToolTip="Reference the tool length at the toolsetter puck (M6 T8, probe already in the spindle) after the origin is set - the core of a one-button job start. Requires ATC and a toolsetter at G59.3."/>
                            <CheckBox x:Uid="ls_measure" x:Name="chkMeasure" Content="Measure stock size (probe all 4 corners)" IsChecked="False" Margin="0,6,0,2" VerticalAlignment="Center"
                                      ToolTip="Probe all four corners to measure the true stock size and skew. When off, the width/height above are used as-is and only the front-left origin (and optional TLO reference) is set."/>
                            <CheckBox x:Uid="ls_heightmap" x:Name="chkHeightMap" Content="Probe height map" IsChecked="False" Margin="18,2,0,2" VerticalAlignment="Center"
                                      IsEnabled="{Binding ElementName=chkMeasure, Path=IsChecked}"
                                      ToolTip="After the origin/size are set, probe a grid over the measured stock area and apply the resulting height map to the loaded job - folds the Height Map tab's own probing into this run. Requires Measure (needs the stock area)."/>
                            <StackPanel Orientation="Horizontal" Margin="36,2,0,2" Visibility="{Binding ElementName=chkHeightMap, Path=IsChecked, Converter={StaticResource ToVisibleConverter}}">
                                <cnccontrols:NumericField x:Name="fldHeightMapGridX" x:Uid="ls_hmGridX" Label="Grid X:" ColonAt="55" Unit="mm" Format="###0.0#" Value="25" Margin="0,0,10,0"
                                                          ToolTip="Grid spacing along X for the height-map probe (mm between probed points)."/>
                                <cnccontrols:NumericField x:Name="fldHeightMapGridY" x:Uid="ls_hmGridY" Label="Grid Y:" ColonAt="55" Unit="mm" Format="###0.0#" Value="25"
                                                          ToolTip="Grid spacing along Y for the height-map probe (mm between probed points)."/>
                            </StackPanel>
                            <CheckBox x:Uid="ls_rotate" x:Name="chkRotate" Content="Set work rotation from skew" IsChecked="True" Margin="18,2,0,2" VerticalAlignment="Center"
                                      IsEnabled="{Binding ElementName=chkMeasure, Path=IsChecked}"
                                      ToolTip="Store the measured stock skew as the work coordinate system's rotation (G10 L2 R), so any program run against this stock is cut aligned to it. Requires firmware with ROTATION_ENABLE. Not available when Set origin or offset is on G92 (a temporary offset has no rotation)."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Dynamic probe-point panel: visible only when the "Dynamic" fixture (the synthetic
                         no-saved-position entry, see G28Fixture) is selected. The dot diagram itself is drawn
                         onto the existing Stock canvas (right column, drawingHost) rather than a second copy
                         here - this panel holds the instructions text and (for the center dot) the solid/hole
                         and round/not-round picks, same pattern as the old Probing tabs' left-column controls. -->
                    <GroupBox x:Uid="ls_grpDynamic" x:Name="grpDynamic" Header="Dynamic probe point" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel Margin="6">
                            <TextBlock x:Name="txtDynamicInstructions" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="Click a green dot on the Stock drawing to pick what to probe, jog the probe over it, then Generate."/>
                            <StackPanel x:Name="pnlCenterMode" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,2">
                                <RadioButton x:Uid="ls_centerSolid" x:Name="rbCenterSolid" Content="Solid boss" GroupName="centerMode" IsChecked="True" Margin="0,0,12,0"/>
                                <RadioButton x:Uid="ls_centerHole" x:Name="rbCenterHole" Content="Hole" GroupName="centerMode"/>
                            </StackPanel>
                            <StackPanel x:Name="pnlHoleShape" Orientation="Horizontal" Visibility="Collapsed" Margin="14,2,0,2">
                                <RadioButton x:Uid="ls_holeRound" x:Name="rbHoleRound" Content="Round" GroupName="holeShape" IsChecked="True" Margin="0,0,12,0"/>
                                <RadioButton x:Uid="ls_holeNotRound" x:Name="rbHoleNotRound" Content="Not round" GroupName="holeShape" IsEnabled="False"
                                             ToolTip="Not implemented in this prototype - non-round hole probing needs more probe points than the round case handles today."/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Warning + result + Generate/Run pinned at the bottom-left of the input column -->
            <StackPanel Grid.Row="1" Margin="0,8,8,0">
                <TextBlock x:Name="txtNoProbe" Foreground="#C0392B" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="No 3D probe defined. Add one in Machine Setup Wizard &gt; Probe definitions - Start Job reads its tip radius and probing feeds."/>
                <TextBlock x:Name="txtExprWarn" Foreground="#C0392B" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="This controller does not report NGC expression support ($I). The generated program needs grblHAL with expressions enabled."/>
                <TextBlock x:Name="txtResult" FontWeight="SemiBold" TextWrapping="Wrap" Text="Measured stock:  X = -   Y = -"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Button x:Uid="ls_copysize" x:Name="btnCopySize" Content="Copy size" MinWidth="90" MinHeight="26" Margin="8,0,0,0" Click="CopySize_Click" IsEnabled="False"
                            ToolTip="Copy the measured stock size (X Y [Z] in mm) to the clipboard for Fusion's ioSenderBatchPost 'measured stock' field."/>
                    <Button x:Uid="ls_verifyskew" x:Name="btnVerify" Content="Verify skew" MinWidth="90" MinHeight="26" Margin="8,0,0,0" Click="VerifySkew_Click" IsEnabled="False"
                            ToolTip="After a measure run: re-apply the measured origin + skew rotation, then touch each corner in the rotated work frame. If the skew is right (and the stock square) the probe lands right at every corner."/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Right: stock drawing - a rectangle from the approximate size before measuring; the true probed
             quad with the measured X/Y spans and each corner's interior angle once a measuring run completes. -->
        <GroupBox x:Uid="ls_grpDrawing" Header="Stock" Grid.Column="2" Margin="8,0,0,0">
            <Border x:Name="drawingHost" Background="White" SnapsToDevicePixels="True" SizeChanged="DrawingHost_SizeChanged"/>
        </GroupBox>
    </Grid>
</UserControl>
