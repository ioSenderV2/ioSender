<Window x:Class="GCode_Sender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:cnccore="clr-namespace:CNC.Core;assembly=CNC.Core"
        xmlns:cnccontrols="clr-namespace:CNC.Controls;assembly=CNC.Controls.WPF"
        xmlns:cncviewer="clr-namespace:CNC.Controls.Viewer;assembly=CNC.Controls.Viewer"
        xmlns:cnclathecontrols="clr-namespace:CNC.Controls.Lathe;assembly=CNC.Controls.Lathe"
        xmlns:cncprobingcontrols="clr-namespace:CNC.Controls.Probing;assembly=CNC.Controls.Probing"
        xmlns:local="clr-namespace:GCode_Sender"
        mc:Ignorable="d"
        Background="#FFE5E5E5"
        Title="Sender ({0})" Height="640" Width="925" MinHeight="700" MinWidth="1250"
        Opacity="0" ShowInTaskbar="False"
        Loaded="Window_Load"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        Closed="Window_Closed" Icon="App.ico">
    <Window.Resources>
        <system:String x:Uid="str_mnuRotate" x:Key="MenuRotate">Rotate</system:String>
        <system:String x:Uid="str_mnuArcsToLines" x:Key="MenuArcsToLines">Arcs to lines</system:String>
        <system:String x:Uid="str_mnuCompress" x:Key="MenuCompress">Compress (experimental)</system:String>
        <system:String x:Uid="str_mnuDragKnife" x:Key="MenuDragKnife">Add drag knife moves</system:String>
        <system:String x:Uid="str_jogStep" x:Key="JogStep">Jog step: {0}</system:String>
        <system:String x:Uid="str_runTime" x:Key="RunTime">Run time: {0}</system:String>
        <cnccontrols:BlocksToStringConverter x:Key="BlocksToStringConverter" />
        <cnccontrols:LogicalNotConverter x:Key="BooleanConverter" />
    </Window.Resources>
    <Window.DataContext>
        <cnccore:GrblViewModel />
    </Window.DataContext>
    <DockPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <DockPanel.LayoutTransform>
            <!-- Whole-app UI scale (Settings:App) - live, no restart. Bound to the static config
                 singleton (not Window.DataContext, which is GrblViewModel) so it scales the entire
                 window - menu, panels, everything - together. -->
            <ScaleTransform ScaleX="{Binding Source={x:Static cnccontrols:AppConfig.Settings}, Path=Base.UiScale}"
                            ScaleY="{Binding Source={x:Static cnccontrols:AppConfig.Settings}, Path=Base.UiScale}"/>
        </DockPanel.LayoutTransform>
        <!-- Menu-overhaul: the File menu is dissolved. Connect/Reconnect is now a top-level item; Load File is
             its own top-level item, Save/Close live on the program view, Open Console is a double-click on
             the Console tab, and Transform is in the program list's right-click menu. Exit is dropped - the
             window X / Alt+F4 (both routed through Window_Closing) quit the app. -->
        <!-- Menu row: the menu itself plus a right-aligned connection summary. It replaces the
             bottom status bar's Target/Run time, and hides itself on a narrow window (see
             UpdateMenuBarInfo) rather than squeezing the menu it shares the row with. -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblMenuBarInfo" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,10,0" TextWrapping="NoWrap" Foreground="#FF3C6E3C" FontWeight="SemiBold"/>
        <Menu x:Name="menuMain" Grid.Column="0" IsEnabled="{Binding Path=IsJobRunning, Converter={StaticResource BooleanConverter}}">
            <MenuItem x:Uid="mnu_connect" x:Name="menuConnect" Header="Co_nnect..." Click="connectMenuItem_Click"/>
            <!-- File / Tools carry a static skeleton here; the view entries (Machine, Settings, SD Card,
                 Feeds and Speeds, ...) are appended from the tab registry by BuildViewMenus, so a
                 registered view declares itself once and never needs an edit to this markup. -->
            <MenuItem x:Uid="mnu_file" x:Name="menuFile" Header="_File">
                <MenuItem x:Uid="mnu_loadFile" x:Name="menuLoadFile" Header="_Load Program..." Click="LoadFile_Click"
                          ToolTip="Load a single g-code file."/>
                <MenuItem x:Uid="mnu_loadWorkOrder" x:Name="menuLoadWorkOrder" Header="Loa_d Work Order..." Click="LoadWorkOrder_Click"
                          ToolTip="Open a saved .workorder file."/>
                <MenuItem x:Uid="mnu_newWorkOrder" x:Name="menuNewWorkOrder" Header="_New Work Order..." Click="NewWorkOrder_Click"
                          ToolTip="Start composing a new work order."/>
                <MenuItem x:Uid="mnu_loadSvgLaser" x:Name="menuLoadSvgLaser" Header="Load SVG Laser _Job..." Click="LoadSvgLaser_Click"
                          ToolTip="Burn an SVG with the laser: pick the artwork, then set width, power, feed and shading. Settings are remembered between jobs."/>
                <Separator x:Name="menuFileViewSeparator"/>
                <!-- Machine + Settings appended here -->
            </MenuItem>
            <MenuItem x:Uid="mnu_tools" x:Name="menuTools" Header="_Tools">
                <MenuItem x:Uid="mnu_camera" x:Name="menuCamera" Header="_Camera" Click="CameraOpen_Click"/>
                <MenuItem x:Uid="mnu_machineMirror" x:Name="menuMachineMirror" Header="Machine _mirror" Click="machineMirror_Click"
                          ToolTip="Read-only live view of the machine state as seen through the client/server wire protocol - a diagnostic for the split. Any disagreement with the main window is a protocol bug."/>
                <!-- SD Card, Feeds and Speeds, the former Tools tab's tools, ... appended here -->
            </MenuItem>
            <MenuItem x:Uid="mnu_help" x:Name="menuHelp" Header="_Help">
                <!-- x:Name on each: registerMenuActions pairs the item with its bindable "Menu.*" action id,
                     both to gate the shortcut on the item's own IsEnabled and to write the bound key back
                     into InputGestureText so the menu advertises it (refreshMenuShortcutText). -->
                <MenuItem x:Uid="mnu_wiki" x:Name="menuWiki" Header="_Wiki" Click="aboutWikiItem_Click"/>
                <MenuItem x:Uid="mnu_usageTips" x:Name="menuUsageTips" Header="Usage _tips" Click="tipsWikiItem_Click"/>
                <MenuItem x:Uid="mnu_briefTour" x:Name="menuBriefTour" Header="A _brief tour" Click="briefTour_Click"/>
                <MenuItem x:Uid="mnu_videoTutorials" x:Name="menuVideoTutorials" Header="_Video tutorials" Click="videoTutorials_Click"/>
                <MenuItem x:Uid="mnu_errorsAndAlarms" x:Name="menuErrorsAndAlarms" Header="_Error and alarm codes" Click="errorAndAlarms_Click"/>
                <Separator/>
                <MenuItem x:Uid="mnu_support" x:Name="menuSupport" Header="_Support" SubmenuOpened="menuSupport_SubmenuOpened">
                    <MenuItem x:Uid="mnu_checkForUpdates" x:Name="menuCheckForUpdates" Header="_Check for updates..." Click="checkForUpdates_Click" ToolTip="Check if a newer version of ioSender is available on GitHub."/>
                    <MenuItem x:Uid="mnu_rollbackVersion" x:Name="menuRollbackVersion" Header="_Roll back to previous version..." Click="rollbackVersion_Click" ToolTip="Swap back to the ioSender build installed before the last update. Only goes back one version - it does not work if you have not updated at least once."/>
                    <MenuItem x:Uid="mnu_openConfigFolder" x:Name="menuOpenConfigFolder" Header="Open Application _data folder" Click="openConfigFolderMenuItem_Click" ToolTip="Open the per-user folder where ioSender keeps its settings (App.config), key mappings, grbl backups and restore points."/>
                    <Separator/>
                    <MenuItem x:Uid="mnu_applyConfigOverlay" x:Name="menuApplyConfigOverlay" Header="Apply configuration _overlay..." Click="applyConfigOverlay_Click" ToolTip="Layer a configuration fragment (.ioconfig) onto this profile - for example to adopt a new screen layout - without disturbing your machine settings, profiles or macros. ioSender restarts to apply it, and it can be undone."/>
                    <MenuItem x:Uid="mnu_exportConfigOverlay" x:Name="menuExportConfigOverlay" Header="E_xport configuration overlay..." Click="exportConfigOverlay_Click" ToolTip="Save this profile's screen layout as a .ioconfig fragment that someone else can apply to their own installation. Machine identity (port, network host, machine) is never included."/>
                    <MenuItem x:Uid="mnu_undoConfigOverlay" x:Name="menuUndoConfigOverlay" Header="_Undo configuration overlay" Click="undoConfigOverlay_Click" ToolTip="Restore the configuration as it was immediately before the last overlay was applied. ioSender restarts."/>
                    <Separator/>
                    <MenuItem x:Uid="mnu_installFusionAddin" x:Name="menuInstallFusionAddin" Header="_Install ioSenderV2 Fusion Addin..." Click="installFusionAddin_Click" ToolTip="Symlink the ioSenderV2 Fusion 360 add-in into Fusion's AddIns folder. Future ioSenderV2 updates need no reinstall - only shown when Fusion 360 is installed for this user." Visibility="Collapsed"/>
                    <MenuItem x:Uid="mnu_generateResetTestCase" Header="Generate _reset test case..." Click="generateResetTestCase_Click" ToolTip="Write a .nc file that calls an O-word subroutine several times, for reproducing controller-wedge-on-Reset bugs." Visibility="Collapsed"/>
                </MenuItem>
                <MenuItem x:Uid="mnu_about" x:Name="menuAbout" Header="_About" Click="aboutMenuItem_Click"/>
            </MenuItem>
        </Menu>
        </Grid>
        <!-- Menu-overhaul: the toolbar row (file-action icons + quick-run macro buttons) was removed. The
             file icons duplicated the program-view header (Load/Close) or were dropped (Reload/Edit); macros
             still run by F-key (KeypressHandler) - a macro-name flyout is a possible future replacement. -->
        <!-- The bottom status bar is gone (2026-08-10). Blocks moved onto the run line, the status
             message became the popup log, and Target/Run time became the menu-bar summary above.
             Jog step is the Jogging group's Distance. Nothing left to justify a whole row. -->
        <!-- Single, always-visible machine-control cluster (Phase 2c) - replaced the former floating
             run-control window and the Grbl-tab's lower-left controls. Signals + Status (state/check +
             Home/Unlock/Reset) + JobControl (Cycle Start [starts a job] / Feed Hold / Stop) +
             Feed/rapid override + MDI. Docked just above the status bar, full width, present on every tab so
             Feed Hold / Stop / MDI are always reachable regardless of the active tab. -->
        <Border x:Name="runControlBorder" DockPanel.Dock="Bottom" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0" Background="#FFF5F5F5">
            <Grid Margin="6,4">
                <!-- LAYOUT PASS 2026-08-09. Five columns:
                     [button row | jog pad | jog config | signals | feeds+overrides]
                     The button-row column is the star, so it grows to consume the slack up to the jog pad;
                     the other four are content-sized and ride at the right edge, adjacent to each other.

                     The strip is deliberately TALLER than before: the right-hand groups are now three rows
                     each (three overrides, three signal groups, three jog fields), which is the vertical
                     real estate this pass was asked for. Height comes from the content, not a fixed value,
                     so the strip grows and shrinks with what is actually in it.

                     This XAML is knowingly throwaway - the desktop client retires at phase H. The point is
                     to settle a layout worth porting to the web client, so treat it as the design surface. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Button-row region (col 0, star): three lines (MDI / run buttons / State), left-aligned; the
                     column grows to fill the slack up to the jog pad. -->
                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <!-- Run line. The MDI entry box that used to live here is gone: a single-line
                             box on the strip was a worse place to type g-code than the console, which
                             has history, multi-line paste and the replies right above it. The button
                             opens that instead, focused and ready to type. -->
                        <Grid Margin="0,5,0,0" Width="{Binding ElementName=buttonRow, Path=ActualWidth}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <cnccontrols:JobControl Grid.Column="0" x:Name="runControl" VerticalAlignment="Center"/>
                            <!-- Block counter, moved up from the status bar: it belongs beside the run
                                 buttons it describes, not in the far corner of the window. -->
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0" TextWrapping="NoWrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource BlocksToStringConverter}">
                                        <Binding Path="Blocks" />
                                        <Binding Path="BlockExecuting" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Button x:Uid="btn_mdiConsole" x:Name="btnMdiConsole" Grid.Column="3" Content="MDI"
                                    Padding="10,3" VerticalAlignment="Center" Click="MdiConsole_Click"
                                    ToolTip="Open the console with the caret in its input box. Esc closes it."/>
                        </Grid>
                        <!-- Button line: the row stretches to fill the star column so its right edge (Program) meets
                             the jog pad; the three groups (status / job / program) are pushed apart by star spacers
                             so the run buttons span the width instead of huddling at the left. -->
                        <Grid x:Name="buttonRow" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <cnccontrols:StatusControl ShowState="False" VerticalAlignment="Center"/>
                                <!-- State moved up onto this line (2026-08-10), set well clear of Reset so
                                     a readout is never mistaken for another button. -->
                                <cnccontrols:StatusControl ShowButtons="False" VerticalAlignment="Center" Margin="28,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <!-- State: / Check directly under Home/Unlock/Reset, with the Jog distance/feed preset
                             spinners on the same line. Width is tied to the button row so the selector's right
                             edge ("Feed") aligns with the Program button's right edge above. -->
                        <Grid Margin="0,7,0,0" Width="{Binding ElementName=buttonRow, Path=ActualWidth}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <!-- Coolant as ONE line. Built here rather than hosting CoolantControl,
                                     which stacks its two switches vertically inside its own group box -
                                     right for a panel, too tall for a strip. The toggles are the same
                                     control it uses, bound to the same Flood/Mist and raising the same
                                     realtime toggle bytes, so behaviour is unchanged. -->
                                <TextBlock x:Uid="lbl_coolant" Text="Coolant:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <cnccontrols:ToggleControl x:Uid="lbl_stripFlood" x:Name="swFlood" Tag="Flood" Label="Flood"
                                                           IsChecked="{Binding Path=Flood, Mode=OneWay}" VerticalAlignment="Center"
                                                           Margin="0,0,12,0" Click="Coolant_Click"
                                                           ToolTip="Turn flood coolant on or off."/>
                                <cnccontrols:ToggleControl x:Uid="lbl_stripMist" x:Name="swMist" Tag="Mist" Label="Mist"
                                                           IsChecked="{Binding Path=Mist, Mode=OneWay}" VerticalAlignment="Center"
                                                           Click="Coolant_Click"
                                                           ToolTip="Turn mist coolant on or off."/>
                                <!-- Demo-video timelapse marker toggle. Hidden unless
                                     launched with -demomarker (visibility set in MainWindow.xaml.cs). Marks
                                     TIMELAPSE_ON/OFF into the demo marker file; see docs/demo-videos. -->
                                <ToggleButton x:Uid="btnTimeLapse" x:Name="btnTimeLapse" Content="Timelapse" MinWidth="80" Margin="12,0,0,0" VerticalAlignment="Center" Focusable="False" Visibility="Collapsed" ToolTip="Demo capture: mark the timelapse window. Flip ON at the moment you switch the camera to timelapse, OFF when you switch back. Auto-ON a few minutes after Run if you don't; auto-OFF at job end." Checked="TimeLapse_Toggled" Unchecked="TimeLapse_Toggled">
                                    <!-- Traffic-light coloring (not the selection highlight): green when OFF
                                         (press to start), red when RUNNING (press to stop). Custom template so
                                         Background is honored in the checked state. -->
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="#2E7D32"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="8,3" SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#C62828"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <!-- Run-bar copy of OBS Control's "All" toggle - same ObsBridge.SetCameraRecording
                                     state as the panel (RtspCamerasControl), placed here so it's reachable without
                                     having to place that panel via Edit Main Page. Hidden unless -demomarker (same
                                     visibility gate as Timelapse, set alongside it in MainWindow.xaml.cs). -->
                                <ToggleButton x:Uid="btnAllRecord" x:Name="btnAllRecord" MinWidth="36" Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False" Visibility="Collapsed" ToolTip="OBS Control - All: click to start/stop every camera together" Style="{StaticResource RecordToggleStyle}" Checked="AllRecord_Toggled" Unchecked="AllRecord_Toggled"/>
                            </StackPanel>
                            <!-- The status MESSAGE strip is gone from the bottom bar; this opens the same
                                 history window its click used to, so a message that scrolled past is still
                                 reachable without a permanent strip of screen spent on it. It lives in the
                                 grid's Auto column, right-aligned: the right edge of the left group, hard
                                 against the DRO that starts the next column. -->
                            <Button x:Uid="btn_viewStatus" x:Name="btnViewStatus" Grid.Column="1" Content="Status"
                                    Padding="10,2" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="ViewStatus_Click"
                                    ToolTip="Show the status message history since launch."/>
                            <!-- Jog distance / feed / kbd speed used to sit here, on the State line. They moved
                                 to their own "Jog config" column in the right-hand group (2026-08-09 layout
                                 pass) so all the jogging controls read as one cluster next to the pad. -->
                        </Grid>
                    </StackPanel>
                <!-- Jog pad (col 1): shrunk arrows-only copy of the Jog-tab control (selection shared via JogData),
                     riding at the left of the right-hand group, just past the button-row column. -->
                <!-- DRO sits immediately left of the jog pad: where you are, right beside the thing
                     that moves you. Scaled to the strip like the pad is. -->
                <cnccontrols:DROControl Grid.Column="1" x:Name="stripDro" VerticalAlignment="Center" Margin="14,0,0,0">
                    <cnccontrols:DROControl.LayoutTransform>
                        <ScaleTransform ScaleX="0.72" ScaleY="0.72"/>
                    </cnccontrols:DROControl.LayoutTransform>
                </cnccontrols:DROControl>

                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="14,0,10,0" VerticalAlignment="Center">
                    <cnccontrols:JogBaseControl x:Name="jogPad" ArrowsOnly="True" HorizontalAlignment="Center">
                        <cnccontrols:JogBaseControl.LayoutTransform>
                            <ScaleTransform ScaleX="0.65" ScaleY="0.65"/>
                        </cnccontrols:JogBaseControl.LayoutTransform>
                    </cnccontrols:JogBaseControl>
<!-- Continuous moved INTO the Jogging group box (2026-08-09): one checkbox for one
                         setting, next to the distance and speed it belongs with. -->
                </StackPanel>

                <!-- The right half, built to docs/RunStrip-Layout-Spec.md: three headed columns
                     (Jogging | Signals | Feeds and Speeds). Replaces the separate JogPresetSelector,
                     KbdDefaultSpeedControl, SignalsControl and FeedControl that used to occupy these
                     columns - see that spec for why none of them fitted the shape asked for. -->
                <cnccontrols:RunStripPanel Grid.Column="3" Grid.ColumnSpan="2" x:Name="runStripPanel"
                                           Margin="4,0,4,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- Top margin clears the main-nav tab STRIP (header row only) so the always-visible flyout panels
             (G28/G30/G59.3/Set etc.) don't overlap the tab labels. Two hand-tuned guesses here (34, then 38)
             both proved wrong once actually tested - a hardcoded number is fragile since it has to be
             re-derived by hand whenever the tab template's rendered height changes for any reason (font, DPI,
             MinHeight tweak). code-behind (MainWindow.xaml.cs, see FindVisualChild<TabPanel> usage) now
             measures the real TabPanel part inside tabMode's template and keeps this Margin in sync via
             SizeChanged, so this XAML value is only the fallback shown before that runs once at startup. -->
        <Canvas x:Name="sidebarCanvas" DockPanel.Dock="Right" Width="22" VerticalAlignment="Stretch" HorizontalAlignment="Right" ClipToBounds="False" Panel.ZIndex="1" Margin="0,38,0,0">
            <ItemsControl x:Name="sidebarTabs" Width="22" VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel IsEnabled="{Binding Path=IsJobRunning, Converter={StaticResource BooleanConverter}}" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Width="22"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <!-- Always-flyouts (no main-page form). Goto/Outline and the other pool panels are added
                 dynamically in code-behind when not placed in a main-page slot. -->
            <cnccontrols:MacroExecuteControl x:Name="macroControl" Visibility="Hidden" Canvas.Right="22"/>
            <cnccontrols:MachinePositionFlyout x:Name="mposFlyout" Visibility="Hidden" Canvas.Right="22"/>
            <cnccontrols:THCMonitorControl x:Name="thcControl" Visibility="Hidden" Canvas.Right="22"/>
        </Canvas>
        <Grid DockPanel.Dock="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- StretchTabControl spreads the tab headers across the full strip width (proportional to each
             label). Recomputes only on tab add/remove and a deferred, post-layout resize callback. -->
        <cnccontrols:StretchTabControl Grid.ColumnSpan="3" IsEnabled="{Binding Path=IsMPGActive, Converter={StaticResource BooleanConverter}}" Background="Transparent" x:Name="tabMode" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" SelectionChanged="TabMode_SelectionChanged">
            <cnccontrols:StretchTabControl.Resources>
                <!-- Apple-flavored main-nav tab: a floating rounded pill for the selected tab (macOS System
                     Settings sidebar style), flat/transparent for unselected ones. Tabs deliberately do NOT
                     use the per-panel functional color system (Position/Jogging/Feed/Coolant) - a tab like
                     "Job" contains ALL of those categories at once, so no single category color describes
                     it correctly. Selected uses the accent's own "light" ramp tier (base 55% + white 45%),
                     NOT the same solid blue as the primary action button - navigation/"you are here" needs
                     to read as visually distinct from "click me," and it fixes a real contrast problem the
                     solid-blue version had (dark text on solid accent blue was hard to read). Base accent
                     blue is reused as the selected tab's TEXT color on top of that light fill, same pattern
                     as the functional-category buttons (base = ink text on the derived light background).
                     This is still navigation chrome, a third, separate use of color from both the primary-
                     action rule and the functional-panel rule. One ContentPresenter throughout
                     (x:Name="header") - StretchTabControl.ApplySelectionEmphasis finds it by walking the
                     visual tree for the first ContentPresenter and bolds/enlarges it on selection, so a
                     second one for the "selected" state would silently break that.

                     Earlier pass used a flared/mesa Path shape here - looked good in isolated mockups but
                     wrong in the real app, reverted to a plain pill.

                     KEYED + applied via ItemContainerStyle, not implicit/keyless: an implicit TargetType-only
                     style here would leak into every OTHER TabControl's TabItems nested anywhere inside this
                     one's content (e.g. JobWorkspace's Program/3D View/Console TabControl) - WPF's implicit
                     style lookup walks the LOGICAL tree, and a tab's content is logically parented under the
                     TabItem that hosts it, so it doesn't stop at this control's own boundary. -->
                <Style x:Key="MainNavTabItemStyle" TargetType="{x:Type TabItem}">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="MinWidth" Value="40" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="pill" CornerRadius="8" Margin="2,3" Background="Transparent" SnapsToDevicePixels="True">
                                    <ContentPresenter x:Name="header" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="10,5" TextElement.Foreground="#FF48484A"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="pill" Property="Background" Value="{StaticResource AppleAccentLightBrush}"/>
                                        <Setter TargetName="pill" Property="Effect" Value="{StaticResource ButtonShadowDefault}"/>
                                        <Setter TargetName="header" Property="TextElement.Foreground" Value="{StaticResource AppleAccentBrush}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="pill" Property="Background" Value="#14000000"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </cnccontrols:StretchTabControl.Resources>
            <!-- Set here (property-element, after Resources) rather than as an attribute on the opening tag:
                 StaticResource is resolved in document order, and an attribute on the opening tag is parsed
                 before this element's own Resources child block registers MainNavTabItemStyle - same "target
                 must appear before" rule as ControlTemplate.Triggers TargetName above. As an attribute this
                 threw 'Provide value on StaticResourceExtension' at startup. -->
            <cnccontrols:StretchTabControl.ItemContainerStyle>
                <StaticResource ResourceKey="MainNavTabItemStyle"/>
            </cnccontrols:StretchTabControl.ItemContainerStyle>
            <!-- Tabs are built in code from TabRegistry (Phase 1: MainWindow is a container).
                 See RegisterBuiltinTabs()/BuildTabs() in MainWindow.xaml.cs. -->
        </cnccontrols:StretchTabControl>
        <!-- On-demand overlays over the tab content (above the run bar). Toggled in MainWindow.xaml.cs. -->
        <!-- Program view always pops on the RIGHT, occupying exactly the rightmost third of the
             client area (Grid.Column="2" of the 3 equal columns above) - was a fixed 560-720px
             MinWidth/MaxWidth before, which ran over half the client area on a narrower window. -->
        <Border x:Name="overlayProgram" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,60,0,0"
                Visibility="Collapsed" Background="White" BorderBrush="#FF888888" BorderThickness="1" Panel.ZIndex="2">
            <!-- Hosts whichever tool's own ProgramView is connected (Load File, or a wizard's Generate
                 output) - each carries its own title bar. Nothing shows here (and the "Program" button is
                 disabled) when nothing is connected; the loaded job's own docked list (ProgramPanel, in the
                 Job tab) is the persistent view of that content, so this popup never duplicates it. -->
            <ContentControl x:Name="overlayActiveHost"/>
        </Border>
        <!-- Console log pops directly ABOVE the command box, matching its width (Esc dismisses). -->
        <Border x:Name="overlayConsole" Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="300" Margin="6,0,0,0"
                Width="{Binding ElementName=mdiControl, Path=ActualWidth}"
                Visibility="Collapsed" Background="White" BorderBrush="#FF888888" BorderThickness="1" Panel.ZIndex="2">
            <cnccontrols:ConsoleControl x:Name="overlayConsoleView" LogOnly="True"/>
        </Border>
        </Grid>
    </DockPanel>
</Window>
