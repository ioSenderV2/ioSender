<Project>
  <!--
    Keep the net8 probe's NuGet artifacts OUT of the shared obj\ folder. BaseIntermediateOutputPath
    set inside an SDK-style csproj is too late for NuGet (MSB3539): restore writes
    obj\project.assets.json anyway, and the LEGACY CNC.Contracts.csproj build then trips over a
    net8.0 assets file ("Your project does not reference .NETFramework,Version=v4.6.2"). The legacy
    project has no PackageReference, so nothing ever overwrites the poisoned file - unlike CNC Core,
    where the WpfUiTestServer restore masks the same latent collision. MSBuildProjectExtensionsPath
    must be set before Microsoft.Common.props, which is exactly what a Directory.Build.props is for.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectFile)' == 'CNC.Contracts.net8.csproj'">
    <MSBuildProjectExtensionsPath>$(MSBuildThisFileDirectory)obj\net8probe\</MSBuildProjectExtensionsPath>
    <BaseIntermediateOutputPath>obj\net8probe\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
